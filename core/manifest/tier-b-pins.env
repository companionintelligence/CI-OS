# Pins for the optional ("Tier B") tools baked into the Companion OS ISO.
# Sourced (never executed) by backends/ubuntu/chroot/customize-chroot.sh Step 10e and by
# backends/ubuntu/iso/scripts/verify-iso.sh. Plain KEY=value, no expansion, no command substitution.
#
# Every value was read from the vendor on the review date below and cross-checked; see
# docs/architecture/tier-b-tools.md for the evidence. To refresh a pin, re-do the check, change the value
# here in the same commit as the bump, and run verify-iso.sh.

TIERB_PINS_REVIEWED=2026-10-13

# ---- Tailscale (apt: https://pkgs.tailscale.com/stable/ubuntu <codename> main) ----
# Primary signing key "Tailscale Inc. (Package repository signing key)", RSA4096, created 2020-02-25, no expiry.
TAILSCALE_KEY_FPR=2596A99EAAB33821893C0A79458CA832957F5868

# ---- cloudflared (apt: https://pkg.cloudflare.com/cloudflared any main) ----
# "CloudFlare Software Packaging 2025", RSA4096, created 2025-10-23, no expiry. Rolled 2025-10-30.
# The old URL cloudflare-public-v2.gpg now serves the identical file (same sha256), so both names verify.
CLOUDFLARED_KEY_FPR=CC94B39C77AE7342A68B89628A682D308D4E5E73

# ---- GitHub CLI (apt: https://cli.github.com/packages stable main) ----
# The vendor keyring holds TWO primary keys. 2C61... expired 2026-09-05; the repo is now signed by 7F38... (created 2026-04-07,
# no expiry). The step installs a keyring containing ONLY the live key; the expired one is tolerated in the download.
GH_KEY_FPR=7F38BBB59D064DBCB3D84D725612B36462313325
GH_KEY_FPR_EXPIRED=2C6106201985B60E6C7AC87323F3D4EA75716059

# ---- Ollama (GitHub release asset; the vendor publishes no signature, only sha256sum.txt) ----
OLLAMA_VERSION=0.40.3
OLLAMA_URL=https://github.com/ollama/ollama/releases/download/v0.40.3/ollama-linux-amd64.tar.zst
OLLAMA_SHA256=ce6f8b671a699bf1ebafb28d60dbbabf4f37b30b499145fa308a8ba72de021d6
OLLAMA_SIZE=1437349190

# ---- Companion Launcher (dl.ci.computer; the Linux .deb has no detached signature, only the manifest sha256) ----
LAUNCHER_VERSION=0.3.5
LAUNCHER_URL=https://dl.ci.computer/v0.3.5/linux/deb/x64/Companion%20Hub_0.3.5_amd64.deb
LAUNCHER_SHA256=f0403c6d5881a6b54be1d11b6b034b0adfaf31f328d35b8f57b7bcac500bdaa8
LAUNCHER_SIZE=39402584
LAUNCHER_PACKAGE=companion-hub
LAUNCHER_BINARY=companion-hub
# ---- arm64 ----
# The same tools for an arm64 image (CI_OS_ARCH=arm64): keys with the suffix _ARM64, read by customize-chroot.sh Step 10e and
# backends/ubuntu/iso/scripts/verify-iso.sh through one helper. Facts fetched 2026-10-19: the Ollama asset and its sha256 from the
# GitHub release v0.40.3 (assets[].digest), the Launcher .deb from https://dl.ci.computer/v0.3.5/manifest.json (linux-aarch64).
# The apt-installed tools (Docker, tailscale, cloudflared, gh) publish arm64 packages for resolute and need no pin here.
# Companion Capture publishes NO Linux arm64 build, so its _ARM64 keys stay empty and an arm64 image does not bake it.
OLLAMA_URL_ARM64=https://github.com/ollama/ollama/releases/download/v0.40.3/ollama-linux-arm64.tar.zst
OLLAMA_SHA256_ARM64=5754700747a93ea14db88888f08072386d2da6fbf7dd75be19a684348b9f28b8
OLLAMA_SIZE_ARM64=1558419074
LAUNCHER_URL_ARM64=https://dl.ci.computer/v0.3.5/linux/deb/arm/Companion%20Hub_0.3.5_arm64.deb
LAUNCHER_SHA256_ARM64=d74b51fda96bb992bedf50b979a7c94fdfef880bccd365bc43b7d37763e900a2
LAUNCHER_SIZE_ARM64=38355362
CAPTURE_URL_ARM64=
CAPTURE_SHA256_ARM64=
CAPTURE_SIZE_ARM64=
# ---- Companion Capture (dl.ci.computer/applet, the same download site as the Launcher; the CI-Capture repository itself is private) ----
# Source: https://dl.ci.computer/applet/latest.json and https://dl.ci.computer/applet/<version>/manifest.json carry the url, size and sha256 of
# every platform. The pins below are the linux-x86_64 .deb of that manifest, fetched 2026-10-19; the sha256 equals the one a
# `gh release download` of the GitHub release gave on 2026-10-18. Companion Capture publishes no Linux arm64 build.
# 0.2.0-alpha.7 (2026-08-06) is a pre-release and the newest. The release also carries a detached signature (.asc, key id
# FD94866DC7B05082) that dl.ci.computer does not serve and whose public key is not published anywhere we found, so the signature is NOT
# verified: the sha256, the size and the .deb control fields are the integrity check. The .deb installs /usr/bin/companion-capture
# and /usr/share/applications/companion-capture.desktop only: no service, no autostart. Capture starts when the user opens it.
CAPTURE_VERSION=0.2.0-alpha.7
CAPTURE_URL=https://dl.ci.computer/applet/v0.2.0-alpha.7/linux/deb/x64/companion-capture_0.2.0-alpha.7_amd64.deb
CAPTURE_SHA256=5d19aa06cd7f11065a8e0be945d038875c719f7b8e042c2dc7160c7682428733
CAPTURE_SIZE=12714476
CAPTURE_PACKAGE=companion-capture
CAPTURE_BINARY=companion-capture
