[Unit]
Description=DNSmasq for setup portal DHCP and DNS
# Started on demand by setup-device-hotspot-start.sh; not enabled at boot.
After=hostapd-setup.service network.target
Requires=hostapd-setup.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --no-daemon -C /etc/dnsmasq.d/setup-portal.conf
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
