# Nginx configuration for setup portal (HTTP only - temporary captive WiFi)
# Serves on port 80. No HTTPS; acceptable for isolated setup network.

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name setup.ci.computer _;

    root /var/www/setup-portal;
    index index.html;

    # Security headers (no HSTS - we use HTTP)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer" always;

    # Captive portal detection (CDC) - redirect to setup portal so OS auto-opens it
    # Use gateway IP (192.168.99.1) for reliability - avoids DNS delays on first connect
    # Apple iOS/macOS: captive.apple.com/hotspot-detect.html
    location /hotspot-detect.html {
        return 302 http://192.168.99.1/;
    }

    # Microsoft Windows 10+: www.msftconnecttest.com/connecttest.txt
    location /connecttest.txt {
        return 302 http://192.168.99.1/;
    }
    # Microsoft Windows (legacy): ncsi.txt
    location /ncsi.txt {
        return 302 http://192.168.99.1/;
    }

    # Android: connectivitycheck.gstatic.com/generate_204 (expects 204; redirect = captive)
    location /generate_204 {
        return 302 http://192.168.99.1/;
    }

    # Firefox: detectportal.firefox.com/canonical.html and success.txt
    location = /canonical.html {
        return 302 http://192.168.99.1/;
    }
    location = /success.txt {
        return 302 http://192.168.99.1/;
    }

    # Main portal page - no cache so captive sheet always gets fresh content
    location = / {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Pragma "no-cache";
        try_files $uri $uri/ /index.html;
    }

    # API proxy
    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static files and SPA fallback - no cache for portal
    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri $uri/ /index.html;
    }

    # Logging
    access_log /var/log/nginx/setup-portal-access.log;
    error_log /var/log/nginx/setup-portal-error.log;
}

# No :5002 proxy here on purpose: the CI Hub container publishes host port 5002 on all interfaces
# (core/lib/ci-hub.sh), so clients on the setup network reach it at http://192.168.99.1:5002 directly, and an
# nginx listener on the same port would make either nginx or Docker fail to bind.
