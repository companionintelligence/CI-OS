# Generated by ci_setup. Do not edit. Start dnsmasq with -C and only this file: no conf-dir is read.
interface=@IFACE@
bind-interfaces
listen-address=@AP_IP@
no-resolv
no-hosts
no-poll
dhcp-authoritative
dhcp-range=@RANGE_START@,@RANGE_END@,@NETMASK@,@LEASE@
dhcp-option=option:router,@AP_IP@
dhcp-option=option:dns-server,@AP_IP@
dhcp-leasefile=@RUN_DIR@/dnsmasq.leases
pid-file=@RUN_DIR@/dnsmasq.pid
address=/#/@AP_IP@
