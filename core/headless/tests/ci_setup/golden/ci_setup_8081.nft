# Generated by ci_setup. Loaded when the setup access point comes up and removed when it goes down.
# Only DHCP (a client without an address yet) is accepted by port alone; everything else needs a source address inside the AP subnet.
# The first four lines make loading idempotent: each table is created if missing, deleted, then defined again,
# all in one transaction.
add table inet ci_setup
delete table inet ci_setup
add table ip ci_setup_nat
delete table ip ci_setup_nat

table inet ci_setup {
  # prerouting at priority raw runs before connection tracking and before Docker's DNAT (dstnat, -100), so a
  # container port published on 0.0.0.0 cannot be reached from the access point.
  chain raw_in {
    type filter hook prerouting priority raw; policy accept;
    iifname "ap0" udp sport 68 udp dport 67 accept
    iifname "ap0" ip saddr 10.77.3.0/24 udp dport 53 accept
    iifname "ap0" ip saddr 10.77.3.0/24 tcp dport { 53, 80 } accept
    iifname "ap0" ip saddr 10.77.3.0/24 ip daddr 10.77.3.1 tcp dport 8081 accept
    iifname "ap0" ip saddr 10.77.3.0/24 ip daddr 224.0.0.251 udp dport 5353 accept
    iifname "ap0" ip saddr 10.77.3.0/24 ip daddr 10.77.3.1 icmp type echo-request limit rate 5/second accept
    iifname "ap0" drop
  }
  # nothing from the access point is routed anywhere, and nothing is routed to it
  chain forward {
    type filter hook forward priority -10; policy accept;
    iifname "ap0" drop
    oifname "ap0" drop
  }
}

table ip ci_setup_nat {
  chain pre {
    type nat hook prerouting priority dstnat - 5; policy accept;
    iifname "ap0" udp dport 53 redirect to :53
    iifname "ap0" tcp dport 53 redirect to :53
    iifname "ap0" tcp dport 80 redirect to :8081
  }
}
