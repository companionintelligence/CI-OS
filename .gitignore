# =====================================================================================
# CI-OS .gitignore - ISO Build Approach
# =====================================================================================

# Build artifacts and temporary files
build/
*.iso
*.img
*.checksum
*-CHECKSUM
temp/
tmp/

# Container images and build cache
.build/
.cache/
*.tar

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# Node.js
node_modules/

# Legacy CI-OS files (from previous approaches)
cubic-project/
iso/

# GitHub Actions artifacts
upload/
artifacts/

# Local development overrides
.env.local
config.local.*

# Container build ignore
.dockerignore