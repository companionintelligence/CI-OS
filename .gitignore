# CI-OS Build Artifacts and Development Files
*.iso
*.iso.rejected
*.iso.CHECKSUM
*.iso.MANIFEST

# Container images and build cache
*.tar
*.tar.gz
*.tar.xz

# Development and testing files
/tmp/
/.tmp/
/test/
*.log
!docs/evidence/**/*.log
*.tmp

# Python bytecode cache
__pycache__/
*.pyc

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local development overrides
config.local.*
*.override.*

# Build outputs (keep source files only)
build/
dist/
out/

# ISO build working directories
/work/
/output/
/work/
backends/ubuntu/iso/work/
backends/ubuntu/iso/output/

# Package build artifacts
*.deb
*.rpm
*.dsc
*.changes
*.buildinfo
backends/*/headless-package/.pkgroot/

# Disk and VM images
*.img
*.qcow2

# Secrets: environment files (the .env.example template is the exception), keys and certificates.
# Tracked configuration such as core/manifest/tier-b-pins.env is not matched; commit templates only, never real values.
.env
.env.*
!.env.example
hub.env
*-env.txt
*.key
*.pem
*.crt
*.p12
*.pfx

# Repository artifacts
/srv/
packages.ci.computer/
# Claude Code agent worktrees (local only)
.claude/worktrees/
