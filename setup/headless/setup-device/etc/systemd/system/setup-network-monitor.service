[Unit]
Description=Setup Device Network Monitor
# Use network.target - network-online can hang on first boot with no connectivity.
# Monitor must start to detect no connectivity and launch hotspot.
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/setup-network-monitor.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
