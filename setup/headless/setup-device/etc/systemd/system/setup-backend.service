[Unit]
Description=Setup Device Backend Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/setup-backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/gunicorn --bind 127.0.0.1:5000 --workers 1 --threads 2 --timeout 120 --access-logfile - --error-logfile - setup_service:app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
