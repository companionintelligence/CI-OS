[Unit]
Description=Setup Device Backend Service
After=nginx.service network-online.target
Requires=nginx.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/setup-backend/setup_service.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
