# CI-OS Bazzite backend — first-boot-only CI Hub Service deploy.
#
# Baked into the image by the sibling image-definition agent at
# /usr/lib/systemd/system/ci-os-first-boot-ci-hub.service (this is the
# image-managed unit path — /usr is where baked content belongs, matching
# ublue-os convention for layered units) via:
#   COPY backends/bazzite/modules/ci-os-first-boot-ci-hub.service \
#        /usr/lib/systemd/system/ci-os-first-boot-ci-hub.service
#   RUN systemctl enable ci-os-first-boot-ci-hub.service
# `systemctl enable` at build time only creates a symlink under
# /etc/systemd/system/multi-user.target.wants/ — no running systemd needed
# in the build container, same principle Ubuntu's ISO chroot step uses (see
# backends/ubuntu/chroot/customize-chroot.sh, which does this by hand with
# `ln -sf` since chroot has no systemctl to call against a non-booted root;
# a bootc Containerfile RUN step CAN call systemctl directly instead).
#
# See ci-os-first-boot-ci-hub.sh's header for the full marker-file/
# idempotency design this ConditionPathExists implements.

[Unit]
Description=CI-OS first-boot CI Hub Service deploy
Documentation=https://ci.computer
After=network-online.target podman.socket
Wants=network-online.target
# Only ever runs once per device — the script also short-circuits on this
# same marker, but ConditionPathExists means systemd skips starting the
# unit at all on every later boot (logged as "skipped", not run-and-exit-0).
ConditionPathExists=!/var/lib/ci-os/.first-boot-ci-hub-done

[Service]
Type=oneshot
RemainAfterExit=yes
# Generous timeout: first-boot registry login + image pull over a slow or
# metered connection can legitimately take a while; a hung step should
# eventually be killed rather than block boot forever.
TimeoutStartSec=1800
ExecStart=/usr/lib/ci-os/modules/ci-os-first-boot-ci-hub.sh
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
