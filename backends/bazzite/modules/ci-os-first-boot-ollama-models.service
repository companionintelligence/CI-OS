# CI-OS Bazzite backend — first-boot-only Ollama model pull.
#
# Baked into the image the same way as ci-os-first-boot-ci-hub.service —
# see that unit's header for the exact COPY + `RUN systemctl enable`
# Containerfile shape the sibling image-definition agent needs to add.
#
# See ci-os-first-boot-ollama-models.sh's header for what is assumed
# already baked (the ollama binary + service itself) versus what this
# first-boot step actually does (pull model weights only).

[Unit]
Description=CI-OS first-boot Ollama model pull
Documentation=https://ci.computer
# ollama.service is baked+enabled at image build time (see the .sh header)
# — order after it, but don't hard-require it: the script itself polls for
# readiness and degrades to a clear warning rather than failing the unit
# outright if Ollama genuinely isn't present.
After=network-online.target ollama.service
Wants=network-online.target
ConditionPathExists=!/var/lib/ci-os/.first-boot-ollama-models-done

[Service]
Type=oneshot
RemainAfterExit=yes
# The qwen3:4b model alone can be multi-gigabyte; give this real room on
# a slow first-boot connection before systemd gives up on it.
TimeoutStartSec=3600
ExecStart=/usr/lib/ci-os/modules/ci-os-first-boot-ollama-models.sh
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
