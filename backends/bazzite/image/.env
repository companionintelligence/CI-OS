# Build defaults for backends/bazzite/image/build.just (loaded via
# `set dotenv-load := true`). Mirrors the ublue-os image-template/bazzite-dx
# convention of a committed .env for non-secret build config — nothing here
# is a credential; override any of these on the command line
# (`just build tag=dev`) or by exporting the var before running `just`.

# Local tag this image builds as: {{IMAGE_NAME}}:{{DEFAULT_TAG}}. Rename
# before pushing to a real registry (e.g. ghcr.io/companionintelligence/ci-os-bazzite).
IMAGE_NAME=ci-os-bazzite
DEFAULT_TAG=latest

# Fedora version Bazzite's `stable` tag currently tracks (per this backend's
# research, at time of writing) — informational only; the Containerfile
# itself resolves VERSION_ID dynamically from /etc/os-release at build time
# for anything that needs it (e.g. Tailscale's repo URL), rather than
# reading this value, so this can't silently drift the build even if it
# goes stale here.
FEDORA_VERSION=44

# bootc-image-builder image `build-qcow2` uses to turn the built OCI image
# into a bootable VM disk for local smoke-testing.
BIB_IMAGE=quay.io/centos-bootc/bootc-image-builder:latest
