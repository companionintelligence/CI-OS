def pick_one(title, text, rows):
    """One row of a searchable list: its code, or None when the dialog was cancelled or nothing was picked."""
    args = ["--list", "--width=620", "--height=560", "--title=" + title, "--text=" + esc(text) + "\n(type to search)",
            "--column=Name", "--column=Code", "--hide-column=2", "--print-column=2", "--ok-label=Choose", "--cancel-label=Back"]
    for label, code in rows:
        args += [label, code]
    r = zenity(args)
    if r.returncode != 0:
        return None
    picked = (r.stdout or "").strip().splitlines()
    picked = picked[0].strip() if picked else ""
    return picked if any(code == picked for _, code in rows) else None


def choose_region(region, data):
    """The language, keyboard and time zone menu. Returns the changed region; "Done" (or closing the window) keeps what is set."""
    titles = {"locale": "Language", "layout": "Keyboard", "timezone": "Time zone"}
    lists = {"locale": "locales", "layout": "layouts", "timezone": "zones"}
    while True:
        rows = []
        for field in REGION_FIELDS:
            rows += [titles[field], label_of(data[lists[field]], region[field])]
        r = zenity(["--list", "--width=620", "--height=300", "--title=Language, keyboard and time zone",
                    "--text=Pick one and press Change. Press Done when all three are right.",
                    "--column=Setting", "--column=Now", "--print-column=1", "--ok-label=Change", "--cancel-label=Done"] + rows)
        if r.returncode != 0:
            return region
        picked = (r.stdout or "").strip().splitlines()
        picked = picked[0].strip() if picked else ""
        field = next((f for f in REGION_FIELDS if titles[f] == picked), None)
        if field is None:
            continue
        rows_of = data[lists[field]]
        code = pick_one(titles[field], f"Now: {label_of(rows_of, region[field])}", rows_of)
        if code:
            region = change_region(region, field, code, data)


def error_dialog(text):
    zenity(["--error", "--width=520", "--title=Companion OS", "--text=" + esc(text)])


def normal_installer():
    for cand in ("ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap", "ubuntu-desktop-bootstrap"):
        if sh(["gtk-launch", cand]).returncode == 0:
            return 0
    subprocess.Popen(["/snap/bin/ubuntu-desktop-bootstrap"], start_new_session=True)
    return 0


def autoinstall_in_the_way():
    """An autoinstall file that is not ours: somebody's own /autoinstall.yaml (never overwrite or remove it), or one that the kernel
    command line names. The installer reads the first of: the server's autoinstall option, the kernel word subiquity.autoinstallpath=<file>,
    /autoinstall.yaml, cloud-init's file, /cdrom/autoinstall.yaml (server.py select_autoinstall): a file named on the kernel command line would be read
    INSTEAD of ours, with a target of its own, and our early-command pin would not be in it."""
    if any(tok.startswith("subiquity.autoinstallpath=") for tok in read_cmdline().split()):
        return True
    if not os.path.lexists(AUTOINSTALL_LINK):
        return False
    return not (os.path.islink(AUTOINSTALL_LINK) and os.readlink(AUTOINSTALL_LINK) == AUTOINSTALL_PATH)


def remove_autoinstall():
    """Remove only our own file and our own symlink."""
    if os.path.islink(AUTOINSTALL_LINK) and os.readlink(AUTOINSTALL_LINK) == AUTOINSTALL_PATH:
        sh(["sudo", "-n", "rm", "-f", AUTOINSTALL_LINK])
    sh(["sudo", "-n", "rm", "-f", AUTOINSTALL_PATH])


def restart_server():
    """Restart the installer's server (it reads /autoinstall.yaml at start). True when systemd accepted the restart."""
    return sh(["sudo", "-n", "systemctl", "restart", SERVER_UNIT]).returncode == 0


def restart_if_idle():
    """After a failure: restart the server so that it drops the autoinstall settings it loaded, unless it is installing.

    A restart kills curtin. When the failure is only that the tool gave up waiting (the install is still going), the
    install is left alone. A server whose state cannot be read is restarted: it is not answering.
    True when the server was restarted."""
    state = status().get("state")
    if state and is_busy(state):
        return False
    return restart_server()


def reopen_normal_installer():
    """After a failure that left nothing installing: open the stock installer window again (this tool closed it). Best effort."""
    try:
        normal_installer()
    except OSError as exc:
        print(f"ci-os-auto-install: could not open the normal installer: {exc}", file=sys.stderr)


# What the progress window says for each state the installer reports while it installs.
PROGRESS_TEXT = {"RUNNING": "Installing Companion OS… this takes a while", "WAITING": "Finishing up…",
                 "LATE_COMMANDS": "Finishing up…", "UU_RUNNING": "Applying updates…"}


def follow_install(say):
    """Follow a confirmed install until the installer says DONE.

    Raises RuntimeError on ERROR, on EXITED (the server leaves before DONE only when something went wrong), when the server
    does not answer for SILENCE_TIMEOUT seconds, and after FOLLOW_TIMEOUT. With `shutdown: poweroff` the machine switches
    itself off right after DONE, so on a real run this function usually never gets to return."""
    shown = None
    silent_since = None
    end = time.time() + FOLLOW_TIMEOUT
    while time.time() < end:
        st = status()
        state = st.get("state")
        if not state:
            now = time.time()
            if silent_since is None:
                silent_since = now
            elif now - silent_since > SILENCE_TIMEOUT:
                raise RuntimeError(f"the installer stopped answering (last state: {shown})")
        else:
            silent_since = None
            if state != shown:
                shown = state
                say(PROGRESS_TEXT.get(state, f"Installer state: {state}"))
            if state == "DONE":
                return
            if state == "ERROR":
                raise RuntimeError("the install failed" + error_detail(st))
            if state == "EXITED":
                raise RuntimeError("the installer exited before the installation was finished")
        time.sleep(FOLLOW_POLL_SECONDS)
    raise RuntimeError("the install did not finish in 4 hours")


def not_ready_text(outcome, state, st):
    """Why wait_for_confirmation() did not end in 'confirm' (or 'started'): a sentence for the failure dialog."""
    if outcome == "failed":
        return f"the installer stopped before it could be told to start (state: {state}{error_detail(st)})"
    if outcome == "ignored":
        return (f"the installer did not take over the automatic install settings: it is in state {state} but in its normal, "
                "interactive mode")
    if state is None:
        return f"the installer's restarted server did not answer within {PREPARE_TIMEOUT // 60} minutes"
    return f"the installer did not reach the confirmation within {PREPARE_TIMEOUT // 60} minutes (it is still in state {state})"


def failure_text(exc, confirmed, reopening):
    """The dialog after a failure: what happened, what became of the disk, where the log is, what to do next."""
    after = "The disk may be partly or completely erased." if confirmed else "Nothing was erased."
    nxt = ("The normal installer opens when you close this message." if reopening
           else "You can try the normal installer from the dock.")
    return (f"The automatic install did not finish: {exc}.\n\n{after}\n"
            f"The installer's log is {SERVER_LOG}, next to the other files in /var/log/installer/ (root can read them). {nxt}")


def run_install(d, cfg_yaml, password):
    """Everything after the consent. Returns an exit code; always leaves no autoinstall file behind.

    The sequence, each step only after the one before it: write the file; restart the server so that it reads it; wait for the NEW
    server to say NEEDS_CONFIRMATION in automatic mode; look at the disks once more; POST /meta/confirm (in that state only); wait
    for an installing state; follow it to DONE."""
    if sh(["sudo", "-n", "true"]).returncode != 0:
        error_dialog("The automatic install needs administrator rights, which this session does not have.")
        return 5
    if autoinstall_in_the_way():
        error_dialog("An autoinstall file that is not Companion OS's own is already in place (a /autoinstall.yaml, or one named on the "
                     "kernel command line). Nothing was changed.")
        return 5
    # Make sure the installer's server is started. It is a snap service and normally runs in a live session; the stock installer window used to be
    # open by this time, and the live session no longer opens it by itself (customize-chroot.sh Step 7b). `start` does nothing when the unit already
    # runs, and a unit that does not exist yet (snapd is still seeding the installer snap) answers non-zero, which wait_ready() below turns into its own
    # bounded wait and message. restart_server() restarts this very unit later.
    sh(["sudo", "-n", "systemctl", "start", SERVER_UNIT])
    state = wait_ready()
    if state is None:
        error_dialog("The installer is not ready. Wait a minute and try again, or use the normal installer.")
        return 5
    if is_busy(state):
        error_dialog("An installation is already running, or an earlier one left the new system mounted at /target. "
                     "Nothing was changed. If nothing is installing, restart the computer from the USB stick to try again.")
        return 5

    confirmed = False
    client_closed = False
    prog = None
    try:
        subprocess.run(["sudo", "-n", "install", "-d", "-m", "0700", RUN_DIR], check=True)
        subprocess.run(["sudo", "-n", "tee", AUTOINSTALL_PATH], input=cfg_yaml, text=True, capture_output=True, check=True)
        subprocess.run(["sudo", "-n", "chmod", "0600", AUTOINSTALL_PATH], check=True)
        # /autoinstall.yaml is where the server looks. A symlink into tmpfs means a crash cannot leave a live
        # autoinstall file behind (persistent Sticks keep the live overlay across boots): it would dangle.
        subprocess.run(["sudo", "-n", "ln", "-sfn", AUTOINSTALL_PATH, AUTOINSTALL_LINK], check=True)
        # One line each time: a "# text" line replaces the whole label, so the sign-in details ride along with every status.
        footer = (f"Sign in afterwards as companion with the one-time password {password}. When the installation is "
                  "finished the computer turns off: remove the USB stick, then turn it on.")
        prog = subprocess.Popen(
            ["zenity", "--progress", "--pulsate", "--no-cancel", "--auto-close", "--width=560",
             "--title=Installing Companion OS", "--text=" + esc(f"Starting the installer…  {footer}")],
            stdin=subprocess.PIPE, text=True, env=zenity_env())

        def say(msg):
            try:
                prog.stdin.write(f"# {esc(msg)}  {esc(footer)}\n")
                prog.stdin.flush()
            except (BrokenPipeError, ValueError):
                pass

        old_server = instance_of(status())       # an answer from this process is never an answer to the settings we write now
        client_closed = True
        sh(["pkill", "-f", CLIENT_PATTERN])      # the stock client would react to the server restarting
        if not restart_server():
            raise RuntimeError("the installer's server could not be restarted, so it never read the automatic install settings")
        time.sleep(3)
        say("The installer is getting ready… this takes about a minute")
        outcome, state, st = wait_for_confirmation(PREPARE_TIMEOUT, old_server)
        if outcome == "confirm":
            # Last look at the disks, after everything the user could have changed while the dialog was open.
            disks2, known2 = classify(flatten(load_lsblk().get("blockdevices", [])), cdrom_source(), backing_for(cdrom_source()))
            same = [x for x in disks2 if x["status"] == "candidate" and x["path"] == d["path"] and x["size"] == d["size"]]
            if not known2 or not same:
                raise RuntimeError("the disks changed after you confirmed, so the install was not started")
            sent, problem = confirm_install()
            confirmed = sent
            if problem:
                raise RuntimeError(problem)
            state, _ = wait_for(INSTALL_STARTED | FAILED_STATES, START_TIMEOUT)
            if state not in INSTALL_STARTED:
                raise RuntimeError(f"the installer did not start after it was confirmed (state: {state})")
        elif outcome == "started":
            confirmed = True
        else:
            raise RuntimeError(not_ready_text(outcome, state, st))
        say(PROGRESS_TEXT["RUNNING"])
        follow_install(say)
    except Exception as exc:  # noqa: BLE001 - one place that turns any failure into a visible dialog
        if prog is not None:
            prog.terminate()
        remove_autoinstall()
        restarted = restart_if_idle()             # drop the loaded autoinstall settings: the next start is a clean one
        reopening = client_closed and restarted and not confirmed
        error_dialog(failure_text(exc, confirmed, reopening))
        if reopening:
            reopen_normal_installer()
        return 7
    prog.terminate()
    remove_autoinstall()
    # With shutdown: poweroff the machine turns itself off about now; this is only seen if it has not yet.
    zenity(["--info", "--width=520", "--title=Companion OS is installed",
            "--text=" + esc("Companion OS is installed.\n\nWhen the computer turns off, remove the USB stick, then turn it on.\n\n"
                            f"Sign in as companion with the one-time password\n{password}")])
    return 0


def pin_to_dock(desktop_id=LAUNCHER_ID):
    """Put the launcher first in the dock's favourites (gsettings org.gnome.shell favorite-apps). True when it is there.

    The live session of Ubuntu 26.04 has no desktop icons to find the launcher by: livecd-rootfs ships a schema override
    in the live layer with disabled-extensions=['ding@rastersoft.com'] (read from the 26.04.1 image), so the file in
    ~/Desktop is never drawn. The dock is, and the stock installer sits in it already. Best effort: a failure is only logged."""
    try:
        got = sh(["gsettings", "get", "org.gnome.shell", "favorite-apps"])
        if got.returncode != 0:
            return False
        text = str(got.stdout).strip()
        favourites = ast.literal_eval(text[4:] if text.startswith("@as ") else text)     # "@as []" is how an empty list prints
        if not isinstance(favourites, list) or not all(isinstance(f, str) for f in favourites):
            return False
        if desktop_id in favourites:
            return True
        done = sh(["gsettings", "set", "org.gnome.shell", "favorite-apps", repr([desktop_id] + favourites)])
        return done.returncode == 0
    except (OSError, ValueError, SyntaxError) as exc:
        print(f"ci-os-auto-install: could not pin the launcher to the dock: {exc}", file=sys.stderr)
        return False


def live_setup():
    """Autostart hook. Does nothing outside a live session, so the installed system is untouched."""
    if not is_live():
        return 0
    home = os.path.expanduser("~")
    for folder in (os.path.join(home, "Desktop"), os.path.join(home, ".local", "share", "applications")):
        try:
            os.makedirs(folder, exist_ok=True)
            dst = os.path.join(folder, "ci-os-auto-install.desktop")
            shutil.copyfile(LAUNCHER_SRC, dst)
            os.chmod(dst, 0o755)
            # The desktop-icons extension only shows a launcher that is marked trusted.
            sh(["gio", "set", dst, "metadata::trusted", "true"])
        except OSError as exc:
            print(f"ci-os-auto-install: could not place the launcher in {folder}: {exc}", file=sys.stderr)
    pin_to_dock()
    if "ci.autoinstall=1" in read_cmdline().split():
        return interactive()
    return 0


