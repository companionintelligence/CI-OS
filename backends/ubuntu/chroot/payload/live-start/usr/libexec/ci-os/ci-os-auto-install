# The installer server's states, from ApplicationState in the 26.04.1 snap (ubuntu-desktop-bootstrap rev 665,
# subiquity/common/types/__init__.py), in the order one run goes through them (server/controllers/install.py):
#   STARTING_UP, CLOUD_INIT_WAIT, EARLY_COMMANDS   the server is starting; it is not ready for a request yet
#   WAITING             idle, waiting for the answers. It is reported BEFORE the install and again AFTER curtin has
#                       written the system, while the server waits for the post-install settings: the name alone does
#                       not say which, so it is told apart by whether the new system is mounted at /target
#   NEEDS_CONFIRMATION  everything is answered and the server waits for POST /meta/confirm
#   RUNNING             the install itself (and the post-install work)
#   UU_RUNNING          unattended-upgrades inside the new system
#   LATE_COMMANDS       the late-commands of the autoinstall file
#   DONE                installed
#   ERROR, EXITED       failed / the server is exiting
# An earlier revision of this tool listed POST_WAIT, POST_RUNNING and UU_CANCELLING; no such states exist, so the
# post-install window (WAITING after curtin) and LATE_COMMANDS slipped through its "already installing" check.
STARTUP_STATES = {"STARTING_UP", "CLOUD_INIT_WAIT", "EARLY_COMMANDS"}
BUSY_STATES = {"RUNNING", "UU_RUNNING", "LATE_COMMANDS", "DONE"}
IDLE_STATES = {"NEEDS_CONFIRMATION", "ERROR", "EXITED"}     # nothing is being written: restarting the server is safe
