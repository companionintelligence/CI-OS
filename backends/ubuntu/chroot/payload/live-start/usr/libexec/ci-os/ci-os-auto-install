# ───────────────────────── pure logic (unit-tested) ─────────────────────────

def flatten(node, parent=None):
    """lsblk -J tree -> flat list of nodes, each with '_parent' = the path of the node above it."""
    out = []
    for n in node:
        n = dict(n)
        n["_parent"] = parent
        out.append(n)
        out.extend(flatten(n.get("children") or [], n.get("path") or parent))
    return out


def load_lsblk():
    fixture = os.environ.get("CI_OS_AI_LSBLK_JSON")
    if fixture:
        with open(fixture, encoding="utf-8") as fh:
            return json.load(fh)
    cols = "NAME,PATH,SIZE,TYPE,RM,RO,HOTPLUG,MODEL,SERIAL,TRAN,FSTYPE,LABEL,PARTLABEL,MOUNTPOINTS,ROTA,PKNAME"
    raw = subprocess.run(["lsblk", "-J", "-b", "-o", cols], check=True, capture_output=True, text=True).stdout
    return json.loads(raw)


def boolish(v):
    return v in (True, 1, "1", "true", "True")


def mountpoints(n):
    mp = n.get("mountpoints")
    if mp is None:
        mp = [n.get("mountpoint")]
    return [m for m in (mp or []) if m]


def clean_source(text):
    """First non-empty line of a findmnt SOURCE, without a '[/subdir]' bind-mount suffix."""
    for line in (text or "").splitlines():
        line = re.sub(r"\[.*\]$", "", line.strip())
        if line:
            return line
    return None


def cdrom_source():
    """The device node mounted at /cdrom ('/dev/sr0', '/dev/sdb1', '/dev/mapper/..', '/dev/loop0'), or None."""
    fixture = os.environ.get("CI_OS_AI_CDROM_SOURCE")
    if fixture is not None:
        return clean_source(fixture)
    try:
        out = subprocess.run(["findmnt", "-no", "SOURCE", "/cdrom"], capture_output=True, text=True).stdout
    except OSError:
        return None
    return clean_source(out)


def loop_backing(source):
    """For a loop /cdrom: {'source': device holding the backing file, 'fstype': its filesystem}, or None if unknown."""
    fixture = os.environ.get("CI_OS_AI_LOOP_BACKING")
    if fixture is not None:
        parts = fixture.split()
        return {"source": parts[0] if parts else None, "fstype": parts[1] if len(parts) > 1 else None} if parts else None
    try:
        back = subprocess.run(["losetup", "-nO", "BACK-FILE", source], capture_output=True, text=True).stdout.strip()
        if not back:
            return None
        out = subprocess.run(["findmnt", "-T", back, "-no", "SOURCE,FSTYPE"], capture_output=True, text=True).stdout
    except OSError:
        return None
    line = next((ln for ln in out.splitlines() if ln.strip()), "")
    fields = line.split()
    if len(fields) < 2:
        return None
    return {"source": clean_source(fields[0]), "fstype": fields[-1]}


def read_cmdline():
    fixture = os.environ.get("CI_OS_AI_CMDLINE")
    if fixture is not None:
        return fixture
    try:
        with open("/proc/cmdline", encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def disk_of(path, nodes):
    """The whole-disk path that carries device `path` (follows partitions and dm parents), or None."""
    by_path = {n.get("path"): n for n in nodes if n.get("path")}
    cur, seen = by_path.get(path), set()
    while cur is not None and cur.get("path") not in seen:
        seen.add(cur.get("path"))
        if cur.get("type") == "disk":
            return cur["path"]
        cur = by_path.get(cur.get("_parent"))
    return None


def protected_disks(nodes, source, backing=None):
    """Disks that must never be an install target. Returns (set_of_disk_paths, medium_known).

    medium_known is False when /cdrom's source could not be traced to a disk (or RAM): the caller must refuse."""
    prot = set()
    known = False
    node = next((n for n in nodes if n.get("path") == source), None) if source else None
    if source:
        d = disk_of(source, nodes)            # a partition, a whole disk, or a dm device on top of one
        if d:
            prot.add(d)
            known = True
        elif node is not None and node.get("type") == "rom":
            prot.add(source)
            known = True
        elif node is not None and node.get("type") == "loop":
            # An ISO booted from a file (GRUB loopback, iso-scan, Ventoy): the disk that HOLDS the file is the medium.
            prot.add(source)
            if backing and backing.get("fstype") in ("tmpfs", "ramfs"):
                known = True                  # netboot into RAM: no disk is involved
            elif backing and backing.get("source"):
                bd = disk_of(backing["source"], nodes)
                if bd:
                    prot.add(bd)
                    known = True
    # Anything that LOOKS like the Companion Stick is protected even when it is not what we booted from.
    for n in nodes:
        labels = {str(n.get("label") or ""), str(n.get("partlabel") or "")}
        if labels & set(STICK_LABELS):
            d = disk_of(n.get("path"), nodes)
            if d:
                prot.add(d)
    # Any disk with something mounted where this session keeps its medium is in use by this session.
    for n in nodes:
        if any(m == p or m.startswith(p + "/") for m in mountpoints(n) for p in MEDIUM_MOUNTS):
            d = disk_of(n.get("path"), nodes)
            if d:
                prot.add(d)
    return prot, known


def external_bus(name):
    """True when sysfs says the disk hangs off USB or Thunderbolt (lsblk's TRAN/RM/HOTPLUG miss some bridges)."""
    try:
        real = os.path.realpath(f"/sys/block/{name}")
    except OSError:
        return False
    return "/usb" in real or "/thunderbolt" in real


def classify(nodes, source, backing=None):
    """Every whole disk -> {'path','model','size','serial','status','reason',...}. status: candidate|excluded."""
    prot, known = protected_disks(nodes, source, backing)
    disks = []
    for n in nodes:
        if n.get("type") != "disk":
            continue
        kids = flatten(n.get("children") or [], n["path"])
        d = {
            "path": n["path"], "name": n.get("name") or os.path.basename(n["path"]), "model": (n.get("model") or "").strip(),
            "size": int(n.get("size") or 0), "serial": (n.get("serial") or "").strip(),
            "tran": (n.get("tran") or "").strip(), "rotational": boolish(n.get("rota")),
            "fstype": n.get("fstype") or "", "label": n.get("label") or "",
            "partitions": [c for c in kids if c.get("type") == "part"],
            "other_children": [c for c in kids if c.get("type") != "part"],
        }
        reason = None
        if n["path"] in prot:
            reason = "the disk this session started from"
        elif boolish(n.get("rm")) or boolish(n.get("hotplug")) or d["tran"] == "usb":
            reason = "removable or USB"
        elif re.match(r"/dev/mmcblk", n["path"]):
            reason = "SD or eMMC card"
        elif external_bus(d["name"]):
            reason = "attached over USB or Thunderbolt"
        elif boolish(n.get("ro")):
            reason = "read-only"
        elif d["size"] < MIN_DISK_BYTES:
            reason = "smaller than 25 GB"
        elif re.match(r"/dev/(loop|zram|ram|sr|fd|nbd|md|dm-)", n["path"]):
            reason = "not a physical disk"
        d["status"] = "excluded" if reason else "candidate"
        d["reason"] = reason
        disks.append(d)
    return disks, known


def choose_default(candidates):
    """The disk preselected in the chooser: solid-state first (NVMe, then others), then the largest."""
    def key(d):
        return (d["tran"] != "nvme", d["rotational"], -d["size"], d["path"])
    return sorted(candidates, key=key)[0] if candidates else None


def human(n):
    for unit, div in (("TB", 1000 ** 4), ("GB", 1000 ** 3), ("MB", 1000 ** 2)):
        if n >= div:
            return f"{n / div:.0f} {unit}" if n >= 10 * div else f"{n / div:.1f} {unit}"
    return f"{n} B"


FS_NAMES = {"ntfs": "Windows (NTFS)", "vfat": "FAT/EFI", "ext4": "Linux (ext4)", "ext3": "Linux (ext3)", "btrfs": "Linux (btrfs)",
            "xfs": "Linux (xfs)", "crypto_LUKS": "encrypted (LUKS)", "swap": "swap", "exfat": "exFAT",
            "apfs": "Apple (APFS)", "hfsplus": "Apple (HFS+)", "zfs_member": "ZFS", "LVM2_member": "LVM",
            "linux_raid_member": "RAID member", "isw_raid_member": "Intel RST RAID member", "BitLocker": "BitLocker"}


def describe_disk(d):
    """('one-line header', [lines: everything found on the disk], has_data). Plain text: escape before markup."""
    head = f"{d['model'] or 'Disk'}  {human(d['size'])}  ({d['path']})"
    lines = []
    if d.get("fstype"):
        lines.append(f"  the whole disk: {FS_NAMES.get(d['fstype'], d['fstype'])}" + (f' "{d["label"]}"' if d.get("label") else ""))
    for p in d["partitions"]:
        fs = p.get("fstype") or ""
        what = FS_NAMES.get(fs, fs) if fs else "contents not recognised"
        label = f' "{p["label"]}"' if p.get("label") else ""
        lines.append(f"  {p.get('name', '?')}: {human(int(p.get('size') or 0))}, {what}{label}")
    for c in d.get("other_children", []):
        lines.append(f"  {c.get('name', '?')}: {c.get('type', 'device')}")
    has_data = bool(d["partitions"] or d.get("fstype") or d.get("other_children"))
    return head, lines, has_data


def summary(d):
    kinds = []
    for p in d["partitions"]:
        k = FS_NAMES.get(p.get("fstype") or "", p.get("fstype") or "")
        if k and k not in kinds and k != "swap":
            kinds.append(k)
    if d.get("fstype") and FS_NAMES.get(d["fstype"], d["fstype"]) not in kinds:
        kinds.insert(0, FS_NAMES.get(d["fstype"], d["fstype"]))
    return ", ".join(kinds[:3]) or ("partitions, contents not recognised" if d["partitions"] else "nothing found")


def esc(text):
    """Plain text -> zenity markup text. zenity (4.x) runs g_strcompress on it, so a backslash must be doubled too."""
    return html.escape(str(text).replace("\\", "\\\\"), quote=False)


def generate_password():
    groups = ["".join(secrets.choice(PW_ALPHABET) for _ in range(4)) for _ in range(4)]
    return "-".join(groups)


def hash_password(pw):
    r = subprocess.run(["openssl", "passwd", "-6", "-stdin"], input=pw, capture_output=True, text=True, check=True)
    return r.stdout.strip()


def target_check_command(d):
    """Shell run by the installer itself (autoinstall early-commands) before it touches any disk."""
    dev = d["path"]
    return (
        f"set -e; "
        f"[ \"$(blockdev --getsize64 {dev})\" = \"{d['size']}\" ] || {{ echo 'ci-os: {dev} is not the disk that was confirmed' >&2; exit 1; }}; "
        f"if findmnt -rn -o SOURCE /cdrom | grep -q '^{dev}'; then echo 'ci-os: {dev} carries the install medium' >&2; exit 1; fi"
    )


def available_extra_groups():
    """Groups the first user is added to on top of the installer's defaults: docker, when this image has the group.

    The installer's own list (adm cdrom dip lpadmin plugdev sambashare debian-tor libvirtd users lxd, plus sudo) has no
    docker, and the Docker engine is part of every Companion OS image. The autoinstall schema of the 26.04.1 installer
    takes `identity.groups: {append: [...]}` (autoinstall-schema.json). useradd is given the names as they are and fails
    on a group that does not exist in the new system, and the new system is a copy of this one: so the group is asked for
    only when it exists here. Without it the oneshot ci-os-docker-group.service still adds the administrators to docker
    at the first boot."""
    groups = []
    try:
        grp.getgrnam("docker")
        groups.append("docker")
    except KeyError:
        pass
    return groups


# ── language, keyboard and time zone ──
# The three answers the installer would otherwise ask first. They default to what the one-click install always used (English,
# US keyboard, time zone from the network) and the confirmation dialog offers to change them. The choices come from the live
# session itself: the locales that are generated here (the ISO carries the language packs for exactly those: de en es fr it pt
# ru zh), the keyboard layouts of xkb's rules file and the time zones of tzdata's zone.tab, named with iso-codes.
DEFAULT_LOCALE = "en_US.UTF-8"
DEFAULT_LAYOUT = "us"
DEFAULT_ZONE = "geoip"                    # the installer asks the network where it is; offline it falls back to UTC
LOCALE_RE = re.compile(r"^[a-z]{2,3}_[A-Z]{2}\.UTF-8$")
LAYOUT_RE = re.compile(r"^[a-z0-9_]{2,16}$")
ZONE_RE = re.compile(r"^(geoip|UTC|[A-Z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){1,2})$")
ISO_639_JSON = "/usr/share/iso-codes/json/iso_639-3.json"
ISO_3166_JSON = "/usr/share/iso-codes/json/iso_3166-1.json"
XKB_BASE_LST = "/usr/share/X11/xkb/rules/base.lst"
ZONE_TAB = "/usr/share/zoneinfo/zone.tab"
LATAM = {"AR", "BO", "CL", "CO", "CR", "CU", "DO", "EC", "GT", "HN", "MX", "NI", "PA", "PE", "PR", "PY", "SV", "US", "UY", "VE"}
REGION_FIELDS = ("locale", "layout", "timezone")


def check_region(locale, layout, timezone):
    """Raise ValueError unless the three values are ones the installer takes (they are written into its autoinstall file)."""
    if not LOCALE_RE.match(str(locale)):
        raise ValueError(f"not a locale like de_DE.UTF-8: {locale!r}")
    if not LAYOUT_RE.match(str(layout)):
        raise ValueError(f"not a keyboard layout code like de: {layout!r}")
    if not ZONE_RE.match(str(timezone)):
        raise ValueError(f"not a time zone like Europe/Berlin (or geoip): {timezone!r}")


def normalize_locale(name):
    """'de_DE.utf8' -> 'de_DE.UTF-8'. None for C, POSIX, the non-UTF-8 duplicates and anything else that is not ll_CC.UTF-8."""
    m = re.match(r"^([a-z]{2,3}_[A-Z]{2})\.(?:utf-?8|UTF-?8)$", (name or "").strip())
    return m.group(1) + ".UTF-8" if m else None


def read_json(path, key):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)[key]
    except (OSError, ValueError, KeyError):
        return []


def language_names():
    """{'de': 'German', 'deu': 'German', ...} from iso-codes (both the two- and three-letter code)."""
    names = {}
    for e in read_json(ISO_639_JSON, "639-3"):
        for k in ("alpha_2", "alpha_3"):
            if e.get(k):
                names[e[k]] = e.get("common_name") or e["name"]
    return names


def country_names():
    return {e["alpha_2"]: e.get("common_name") or e["name"] for e in read_json(ISO_3166_JSON, "3166-1") if e.get("alpha_2")}


def locale_label(locale, languages, countries):
    lang, country = locale.split(".")[0].split("_")
    name = languages.get(lang)
    if not name:
        return locale
    return f"{name} ({countries[country]})" if country in countries else name


def generated_locales():
    """The UTF-8 locales generated in this live session, as ll_CC.UTF-8, without duplicates."""
    r = sh(["locale", "-a"])
    seen = []
    for line in (r.stdout or "").splitlines() if r.returncode == 0 else []:
        loc = normalize_locale(line)
        if loc and loc not in seen:
            seen.append(loc)
    return seen


def parse_layouts(text):
    """[(name, code)] of the `! layout` section of xkb's base.lst."""
    out, inside = [], False
    for line in text.splitlines():
        if line.startswith("!"):
            inside = line.strip() == "! layout"
            continue
        parts = line.split(None, 1)
        if inside and len(parts) == 2 and LAYOUT_RE.match(parts[0]) and parts[0] != "custom":   # "custom" is a placeholder, not a layout
            out.append((parts[1].strip(), parts[0]))
    return out


def parse_zones(text, countries):
    """([(label, zone)], {country code: [zone, ...]}) from zone.tab: 'Berlin, Germany' for Europe/Berlin."""
    rows, by_country = [], {}
    for line in text.splitlines():
        cols = line.split("\t")
        if line.startswith("#") or len(cols) < 3 or not ZONE_RE.match(cols[2]):
            continue
        cc, zone = cols[0], cols[2]
        city = zone.rsplit("/", 1)[1].replace("_", " ")
        rows.append((f"{city}, {countries[cc]}" if cc in countries else city, zone))
        by_country.setdefault(cc, []).append(zone)
    return sorted(rows, key=lambda r: r[0].casefold()), by_country


def load_region_data():
    """Everything the three pick lists need, read once. Never empty: a missing file leaves the defaults and the fallbacks."""
    languages, countries = language_names(), country_names()
    locales = generated_locales() or [DEFAULT_LOCALE]
    if DEFAULT_LOCALE not in locales:
        locales.append(DEFAULT_LOCALE)
    try:
        with open(XKB_BASE_LST, encoding="utf-8") as f:
            layouts = parse_layouts(f.read())
    except OSError:
        layouts = []
    try:
        with open(ZONE_TAB, encoding="utf-8") as f:
            zones, by_country = parse_zones(f.read(), countries)
    except OSError:
        zones, by_country = [], {}
    if not any(code == DEFAULT_LAYOUT for _, code in layouts):
        layouts.append(("English (US)", DEFAULT_LAYOUT))
    return {
        "locales": sorted(((locale_label(l, languages, countries), l) for l in locales), key=lambda r: r[0].casefold()),
        "layouts": sorted(layouts, key=lambda r: r[0].casefold()),
        "zones": [("Detect automatically (needs the internet)", DEFAULT_ZONE), ("UTC (no region)", "UTC")] + zones,
        "by_country": by_country,
    }


def suggest_layout(locale, layouts):
    """The keyboard layout most people who chose this locale use; US when nothing fits. They can change it in the dialog."""
    base = locale.split(".")[0]
    lang, country = base.split("_")
    codes = {code for _, code in layouts}
    if lang == "en":
        order = ["gb"] if country == "GB" else []
    elif lang == "es" and country in LATAM:
        order = ["latam"]
    elif base == "de_IT":                       # German speakers of South Tyrol: not the Italian keyboard
        order = [lang]
    else:
        order = [{"BR": "br"}.get(country, country.lower()), lang]
    return next((c for c in order if c in codes), DEFAULT_LAYOUT)


def suggest_zone(locale, by_country):
    """The country's only time zone when it has exactly one; otherwise automatic detection."""
    zones = by_country.get(locale.split(".")[0].split("_")[1], [])
    return zones[0] if len(zones) == 1 else DEFAULT_ZONE


def new_region(locale=DEFAULT_LOCALE, layout=DEFAULT_LAYOUT, timezone=DEFAULT_ZONE):
    check_region(locale, layout, timezone)
    return {"locale": locale, "layout": layout, "timezone": timezone, "touched": set()}


def change_region(region, field, value, data):
    """A copy of `region` with one answer changed. Choosing a language re-suggests the keyboard and the time zone, except for one
    the user already chose by hand."""
    if field not in REGION_FIELDS:
        raise ValueError(f"unknown setting: {field!r}")
    new = dict(region, touched=set(region["touched"]) | {field})
    new[field] = value
    if field == "locale":
        if "layout" not in new["touched"]:
            new["layout"] = suggest_layout(value, data["layouts"])
        if "timezone" not in new["touched"]:
            new["timezone"] = suggest_zone(value, data["by_country"])
    check_region(new["locale"], new["layout"], new["timezone"])
    return new


def label_of(rows, code):
    return next((label for label, c in rows if c == code), code)


def describe_region(region, data):
    """The three answers in words, for the confirmation dialog and --plan."""
    zone = region["timezone"]
    zone_text = "detected automatically" if zone == DEFAULT_ZONE else label_of(data["zones"], zone)
    return (f"{label_of(data['locales'], region['locale'])}, keyboard: {label_of(data['layouts'], region['layout'])}, "
            f"time zone: {zone_text}")


def build_autoinstall(d, password_hash, *, username="companion", realname="Companion", hostname="companion-os",
                      extra_groups=None, locale=DEFAULT_LOCALE, layout=DEFAULT_LAYOUT, timezone=DEFAULT_ZONE):
    check_region(locale, layout, timezone)
    identity = {"realname": realname, "hostname": hostname, "username": username, "password": password_hash}
    if extra_groups is None:
        extra_groups = available_extra_groups()
    if extra_groups:
        identity["groups"] = {"append": list(extra_groups)}
    cfg = {
        "autoinstall": {
            "version": 1,
            "locale": locale,
            "keyboard": {"layout": layout},
            "timezone": timezone,
            "identity": identity,
            "storage": {"layout": {"name": "direct", "match": {"path": d["path"]}}},
            "refresh-installer": {"update": False},
            "drivers": {"install": False},
            "codecs": {"install": False},
            "updates": "security",
            # poweroff, not reboot: a stick left in the machine would boot the live session again, and the user
            # is told to remove it when the screen goes dark.
            "shutdown": "poweroff",
            "early-commands": [target_check_command(d)],
            # The first sign-in must set a real password. A stray autoinstall.yaml must not survive into the target.
            "late-commands": [
                f"curtin in-target --target=/target -- chage -d 0 {username}",
                "rm -f /target/autoinstall.yaml /target/var/log/installer/autoinstall-user-data",
            ],
        }
    }
    return cfg


def dump_yaml(cfg, mask_hash=False):
    import yaml
    c = json.loads(json.dumps(cfg))
    if mask_hash:
        c["autoinstall"]["identity"]["password"] = "<sha512-crypt hash, not shown>"
    return yaml.safe_dump(c, sort_keys=False, default_flow_style=False)


# ───────────────────────── system interaction ─────────────────────────

def is_live():
    return os.path.exists("/cdrom/casper/vmlinuz") or "boot=casper" in read_cmdline()


def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def take_lock():
    """One instance at a time. Returns True when this process holds the lock."""
    global _lock_fd
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "ci-os-auto-install.lock")
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return False
    _lock_fd = fd
    return True


def api(method, path, data=None, timeout=20, query=None):
    """(http_status, body) from the installer's API; (0, '') when it cannot be reached.

    `data` is a JSON request body (the API's Payload arguments), `query` a dict of query arguments. The installer's API takes
    every other argument from the query string, JSON-encoded: {"tty": "/dev/tty1"} becomes ?tty=%22%2Fdev%2Ftty1%22."""
    url = f"http://a{path}"
    if query:
        url += "?" + urllib.parse.urlencode({k: json.dumps(v) for k, v in query.items()}, quote_via=urllib.parse.quote)
    cmd = ["sudo", "-n", "curl", "-sS", "--max-time", str(timeout), "--unix-socket", SOCKET, "-X", method,
           "-w", "\n%{http_code}", url]
    if data is not None:
        cmd += ["-H", "Content-Type: application/json", "-d", json.dumps(data)]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except OSError:
        return 0, ""
    body, _, code = r.stdout.rpartition("\n")
    try:
        return int(code), body
    except ValueError:
        return 0, ""


def status():
    code, body = api("GET", "/meta/status")
    if code != 200:
        return {}
    try:
        st = json.loads(body or "{}")
    except ValueError:
        return {}
    return st if isinstance(st, dict) else {}


def instance_of(st):
    """Which server process answered: 'subiquity_log.<pid>' (it changes with every restart of the server), or None."""
    return st.get("log_syslog_id") or st.get("echo_syslog_id") or None


def error_detail(st):
    """The installer's own words about why it is in ERROR, cut short ('' when it says nothing)."""
    ne = st.get("nonreportable_error")
    if isinstance(ne, dict) and ne.get("cause"):
        if ne["cause"] == "AutoinstallUserSuppliedCmdError":     # the only command we hand it is the target check
            return "; the check that the disk is still the one you confirmed did not pass"
        return f"; {ne['cause']}: {str(ne.get('message') or '')[:160]}"
    er = st.get("error")
    if isinstance(er, dict) and er.get("kind"):
        return f"; {er['kind']}, crash report {er.get('base')}"
    return ""


def wait_for(states, timeout, poll=None):
    """Poll the installer until its state is in `states`. Returns (state, status) or (last state seen, {})."""
    end = time.time() + timeout
    last = None
    while time.time() < end:
        st = status()
        last = st.get("state", last)
        if st.get("state") in states:
            return st["state"], st
        time.sleep(poll or POLL_SECONDS)
    return last, {}


def wait_ready(timeout=180):
    """The installer's server answers and has finished starting. Returns its state, or None."""
    end = time.time() + timeout
    while time.time() < end:
        state = status().get("state")
        if state and state not in STARTUP_STATES:
            return state
        time.sleep(POLL_SECONDS)
    return None


def wait_for_confirmation(timeout, old_instance=None, poll=None):
    """After the restart: wait until the NEW server is ready to be told to start. Returns (outcome, state, status):

      confirm   NEEDS_CONFIRMATION, and the server says it is in automatic mode (interactive false): POST /meta/confirm may follow
      started   the server is already past the confirmation (a kernel command line with `autoinstall` skips it)
      failed    ERROR or EXITED
      ignored   the server is idle but not in automatic mode: it did not read our autoinstall file, so it will never get there
      timeout   none of the above within `timeout` seconds; `state` is the last one seen

    An answer from the server that was running before the restart (same `old_instance`) is not an answer."""
    end = time.time() + timeout
    state, st = None, {}
    while time.time() < end:
        cur = status()
        got = cur.get("state")
        if got and not (old_instance and instance_of(cur) == old_instance):
            state, st = got, cur
            if got in FAILED_STATES:
                return "failed", got, cur
            if got in INSTALL_STARTED:
                return "started", got, cur
            if got in (AMBIGUOUS_STATE, "NEEDS_CONFIRMATION") and cur.get("interactive") is not False:
                return "ignored", got, cur
            if got == "NEEDS_CONFIRMATION":
                return "confirm", got, cur
        time.sleep(poll or POLL_SECONDS)
    return "timeout", state, st


def confirm_install():
    """The one request that starts the installation: POST /meta/confirm, and only to a server that is waiting for it, in automatic mode.

    Returns (sent, problem). `sent` is True when the installer may have taken the confirmation (HTTP 200, no answer at all, or it
    went on regardless), so that the failure text is honest about the disk. `problem` is None or why the install was not started."""
    st = status()
    if st.get("state") != "NEEDS_CONFIRMATION" or st.get("interactive") is not False:
        return False, f"the installer is not waiting for the confirmation (state: {st.get('state')})"
    code, body = api("POST", "/meta/confirm", query={"tty": CONFIRM_TTY})
    if code == 200:
        return True, None
    # Not a 200: the server's own state says whether the confirmation took effect all the same.
    after, _ = wait_for(INSTALL_STARTED | FAILED_STATES, 10)
    if after in INSTALL_STARTED:
        return True, None
    lines = [ln.strip() for ln in body.splitlines() if ln.strip()]
    detail = f": {lines[-1][:160]}" if lines else ""
    return code == 0, f"the installer refused the confirmation (HTTP {code}{detail})"


def target_in_use():
    """True when the new system is mounted at /target (or something is mounted below it).

    curtin mounts the system it installs there and unmounts it at the very end, so a mounted /target means an install
    has written, or is writing, to a disk. When the mount table cannot be read the answer is True (fail closed)."""
    try:
        with open(MOUNTINFO, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return True
    for line in lines:
        fields = line.split()
        if len(fields) < 5:
            continue
        mountpoint = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), fields[4])   # \040 is a space in mountinfo
        if mountpoint == TARGET or mountpoint.startswith(TARGET + "/"):
            return True
    return False


def curtin_running():
    """True when a curtin process exists: the installer's disk work. pgrep that cannot run counts as running."""
    try:
        return sh(["pgrep", "-f", CURTIN_PATTERN]).returncode == 0
    except OSError:
        return True


def is_busy(state):
    """True when the installer must not be touched (no new autoinstall file, no restart of its server).

    BUSY_STATES are busy. WAITING is busy when an install has written to a disk (/target is mounted) or curtin is running,
    and idle otherwise (the installer just started, nothing answered). NEEDS_CONFIRMATION, ERROR and EXITED write nothing.
    Anything else, including a state this tool has never heard of, counts as busy: a wrong "busy" costs one more click,
    a wrong "idle" restarts the server in the middle of writing a disk."""
    if state in BUSY_STATES:
        return True
    if state == AMBIGUOUS_STATE:
        return target_in_use() or curtin_running()
    if state in IDLE_STATES:
        return False
    return True


def zenity_env():
    # ZENITY_OK / ZENITY_CANCEL / DIALOG_* can remap zenity's exit codes; the answer must mean what it says.
    return {k: v for k, v in os.environ.items() if not k.startswith(("ZENITY_", "DIALOG_"))}


def zenity(args, **kw):
    return subprocess.run(["zenity"] + args, capture_output=True, text=True, env=zenity_env(), **kw)


def choose_disk(candidates, default):
    """The one disk to offer. With several candidates the user picks; nothing is guessed. None = cancelled."""
    if len(candidates) == 1:
        return candidates[0]
    args = ["--list", "--radiolist", "--width=720", "--height=420", "--title=Install Companion OS",
            "--text=More than one internal disk was found. Which one should Companion OS be installed on?\n"
            "(You are asked to confirm before anything is erased.)",
            "--column=Pick", "--column=Device", "--column=Disk", "--column=Size", "--column=Found on it",
            "--print-column=2", "--ok-label=Continue", "--cancel-label=Cancel"]
    for d in sorted(candidates, key=lambda x: x["path"]):
        args += ["TRUE" if d is default else "FALSE", d["path"], d["model"] or "Disk", human(d["size"]), summary(d)]
    r = zenity(args)
    if r.returncode != 0:
        return None
    picked = (r.stdout or "").strip().splitlines()
    picked = picked[0].strip() if picked else ""
    return next((d for d in candidates if d["path"] == picked), None)


DEFAULT_REGION_TEXT = "English (United States), keyboard: English (US), time zone: detected automatically"
BTN_REGION = "Language, keyboard, time zone..."
BTN_NORMAL = "Use the normal installer"


