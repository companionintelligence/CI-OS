#!/usr/bin/env python3
"""Companion OS: one-click automatic install, from the live session.

The user clicks "Install Companion OS (automatic)". This tool picks the internal disk, shows ONE
confirmation that names the disk and what is on it, and then drives Canonical's own installer
(ubuntu-desktop-bootstrap's subiquity server) through its autoinstall path with no further questions:
English, US keyboard, time zone from geoip, the Default application selection, "Erase disk and install".

It does not replace or modify the installer. It writes an autoinstall file, restarts the installer's
server so that it loads it, confirms the install over the server's own API and reports progress.

Safety rules (each one is tested in backends/ubuntu/chroot/tests/test_auto_install.py):
  * Never the boot medium. Every disk that carries /cdrom, /isodevice or a Companion Stick partition
    (CI-EFI, CI-SHARED, CI-BOOT-A/B, CI-CACHE, CI-PERSIST, writable, casper-rw) is excluded. A /cdrom on a loop
    device is followed to the disk that holds the ISO file. If the boot medium cannot be identified the tool
    REFUSES (fail closed) and offers the normal installer instead.
  * Only internal disks: not removable, not hotplug, not USB/Thunderbolt-attached, not an SD/eMMC card, not
    read-only, big enough (25 GB). With more than one such disk the user chooses; nothing is guessed.
  * One confirmation that names model, size, device and everything found on the disk. Enter never confirms:
    the dialog's default is Cancel.
  * The target is pinned by an early-command inside the install itself: if the disk's size is not the
    one that was shown, or the disk now carries /cdrom, the install aborts before it writes anything. The
    disk list is also re-checked after the click and again just before the install is confirmed.
  * One instance at a time (flock), and it refuses to touch an installer that is already installing.
  * The sign-in password is random, shown in the confirmation and in the progress window, and must be changed
    at first login. Only its hash goes into the autoinstall file, which lives on tmpfs and is removed
    afterwards. A foreign /autoinstall.yaml is never overwritten or removed.

Usage:
  ci-os-auto-install                 interactive (zenity), the normal entry point
  ci-os-auto-install --plan          print the chosen disk and the autoinstall file (password hash masked),
                                     change nothing. Exit 0, or 3 when no safe disk exists
  ci-os-auto-install --disks         print the candidate/excluded disk table
  ci-os-auto-install --live-setup    desktop-session autostart hook: in a live session only, put the launcher on the
                                     desktop, in the app grid and first in the dock (the 26.04 live session draws no
                                     desktop icons); with ci.autoinstall=1 on the kernel command line
                                     (the boot menu's automatic entry) it also starts the install dialog
Environment (tests only): CI_OS_AI_LSBLK_JSON, CI_OS_AI_CDROM_SOURCE, CI_OS_AI_LOOP_BACKING ("<device> <fstype>"),
CI_OS_AI_CMDLINE read fixtures instead of the system.

Exit codes: 0 ok, 2 usage, 3 no safe target / medium unknown, 4 not a live session, 5 installer not ready or busy,
6 user cancelled (or another instance is open), 7 install failed.
"""
import argparse
import ast
import fcntl
import grp
import html
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import time

MIN_DISK_BYTES = 25 * 1000 ** 3
SERVER_UNIT = "snap.ubuntu-desktop-bootstrap.subiquity-server.service"
# The stock installer window: the snap's launcher runs bin/ubuntu_bootstrap as the app command (command-chain bin/launcher),
# so its command line starts with the snap path (checked in the 26.04.1 snap, rev 665: meta/snap.yaml and bin/launcher).
CLIENT_PATTERN = r"^/snap/ubuntu-desktop-bootstrap/[^ ]*/ubuntu_bootstrap"
SOCKET = "/run/subiquity/socket"
RUN_DIR = "/run/ci-os-auto-install"
AUTOINSTALL_PATH = os.path.join(RUN_DIR, "autoinstall.yaml")
AUTOINSTALL_LINK = "/autoinstall.yaml"
LAUNCHER_SRC = "/usr/share/ci-os/live/ci-os-auto-install.desktop"
LAUNCHER_ID = "ci-os-auto-install.desktop"
STICK_LABELS = ("CI-EFI", "CI-SHARED", "CI-BOOT-A", "CI-BOOT-B", "CI-CACHE", "CI-PERSIST", "writable", "casper-rw")
# Mount points that mean "this session is running from / through this disk".
MEDIUM_MOUNTS = ("/cdrom", "/isodevice", "/rofs", "/run/ci-os", "/run/live")
# The installer server's states, from ApplicationState in the 26.04.1 snap (ubuntu-desktop-bootstrap rev 665,
# subiquity/common/types/__init__.py), in the order one run goes through them (server/controllers/install.py):
#   STARTING_UP, CLOUD_INIT_WAIT, EARLY_COMMANDS   the server is starting; it is not ready for a request yet
#   WAITING             idle, waiting for the answers. It is reported BEFORE the install and again AFTER curtin has
#                       written the system, while the server waits for the post-install settings: the name alone does
#                       not say which, so it is told apart by whether the new system is mounted at /target
#   NEEDS_CONFIRMATION  everything is answered and the server waits for POST /meta/confirm
#   RUNNING             the install itself (and the post-install work)
#   UU_RUNNING          unattended-upgrades inside the new system
#   LATE_COMMANDS       the late-commands of the autoinstall file
#   DONE                installed
#   ERROR, EXITED       failed / the server is exiting
# An earlier revision of this tool listed POST_WAIT, POST_RUNNING and UU_CANCELLING; no such states exist, so the
# post-install window (WAITING after curtin) and LATE_COMMANDS slipped through its "already installing" check.
STARTUP_STATES = {"STARTING_UP", "CLOUD_INIT_WAIT", "EARLY_COMMANDS"}
BUSY_STATES = {"RUNNING", "UU_RUNNING", "LATE_COMMANDS", "DONE"}
IDLE_STATES = {"NEEDS_CONFIRMATION", "ERROR", "EXITED"}     # nothing is being written: restarting the server is safe
INSTALL_STARTED = BUSY_STATES                               # the states that mean "the install was confirmed and is under way"
AMBIGUOUS_STATE = "WAITING"
FAILED_STATES = {"ERROR", "EXITED"}
MOUNTINFO = "/proc/self/mountinfo"
TARGET = "/target"                                          # where curtin mounts the system it installs
CURTIN_PATTERN = r"(^|[ /])curtin( |$)"                     # "python3 -m curtin ...", ".../bin/curtin in-target ..."
PW_ALPHABET = "abcdefghjkmnpqrstuvwxyz23456789"   # no 0/o/1/l/i: it is read off a screen and typed

_lock_fd = None


# ───────────────────────── pure logic (unit-tested) ─────────────────────────

def flatten(node, parent=None):
    """lsblk -J tree -> flat list of nodes, each with '_parent' = the path of the node above it."""
    out = []
    for n in node:
        n = dict(n)
        n["_parent"] = parent
        out.append(n)
        out.extend(flatten(n.get("children") or [], n.get("path") or parent))
    return out


def load_lsblk():
    fixture = os.environ.get("CI_OS_AI_LSBLK_JSON")
    if fixture:
        with open(fixture, encoding="utf-8") as fh:
            return json.load(fh)
    cols = "NAME,PATH,SIZE,TYPE,RM,RO,HOTPLUG,MODEL,SERIAL,TRAN,FSTYPE,LABEL,PARTLABEL,MOUNTPOINTS,ROTA,PKNAME"
    raw = subprocess.run(["lsblk", "-J", "-b", "-o", cols], check=True, capture_output=True, text=True).stdout
    return json.loads(raw)


def boolish(v):
    return v in (True, 1, "1", "true", "True")


def mountpoints(n):
    mp = n.get("mountpoints")
    if mp is None:
        mp = [n.get("mountpoint")]
    return [m for m in (mp or []) if m]


def clean_source(text):
    """First non-empty line of a findmnt SOURCE, without a '[/subdir]' bind-mount suffix."""
    for line in (text or "").splitlines():
        line = re.sub(r"\[.*\]$", "", line.strip())
        if line:
            return line
    return None


def cdrom_source():
    """The device node mounted at /cdrom ('/dev/sr0', '/dev/sdb1', '/dev/mapper/..', '/dev/loop0'), or None."""
    fixture = os.environ.get("CI_OS_AI_CDROM_SOURCE")
    if fixture is not None:
        return clean_source(fixture)
    try:
        out = subprocess.run(["findmnt", "-no", "SOURCE", "/cdrom"], capture_output=True, text=True).stdout
    except OSError:
        return None
    return clean_source(out)


def loop_backing(source):
    """For a loop /cdrom: {'source': device holding the backing file, 'fstype': its filesystem}, or None if unknown."""
    fixture = os.environ.get("CI_OS_AI_LOOP_BACKING")
    if fixture is not None:
        parts = fixture.split()
        return {"source": parts[0] if parts else None, "fstype": parts[1] if len(parts) > 1 else None} if parts else None
    try:
        back = subprocess.run(["losetup", "-nO", "BACK-FILE", source], capture_output=True, text=True).stdout.strip()
        if not back:
            return None
        out = subprocess.run(["findmnt", "-T", back, "-no", "SOURCE,FSTYPE"], capture_output=True, text=True).stdout
    except OSError:
        return None
    line = next((ln for ln in out.splitlines() if ln.strip()), "")
    fields = line.split()
    if len(fields) < 2:
        return None
    return {"source": clean_source(fields[0]), "fstype": fields[-1]}


def read_cmdline():
    fixture = os.environ.get("CI_OS_AI_CMDLINE")
    if fixture is not None:
        return fixture
    try:
        with open("/proc/cmdline", encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def disk_of(path, nodes):
    """The whole-disk path that carries device `path` (follows partitions and dm parents), or None."""
    by_path = {n.get("path"): n for n in nodes if n.get("path")}
    cur, seen = by_path.get(path), set()
    while cur is not None and cur.get("path") not in seen:
        seen.add(cur.get("path"))
        if cur.get("type") == "disk":
            return cur["path"]
        cur = by_path.get(cur.get("_parent"))
    return None


def protected_disks(nodes, source, backing=None):
    """Disks that must never be an install target. Returns (set_of_disk_paths, medium_known).

    medium_known is False when /cdrom's source could not be traced to a disk (or RAM): the caller must refuse."""
    prot = set()
    known = False
    node = next((n for n in nodes if n.get("path") == source), None) if source else None
    if source:
        d = disk_of(source, nodes)            # a partition, a whole disk, or a dm device on top of one
        if d:
            prot.add(d)
            known = True
        elif node is not None and node.get("type") == "rom":
            prot.add(source)
            known = True
        elif node is not None and node.get("type") == "loop":
            # An ISO booted from a file (GRUB loopback, iso-scan, Ventoy): the disk that HOLDS the file is the medium.
            prot.add(source)
            if backing and backing.get("fstype") in ("tmpfs", "ramfs"):
                known = True                  # netboot into RAM: no disk is involved
            elif backing and backing.get("source"):
                bd = disk_of(backing["source"], nodes)
                if bd:
                    prot.add(bd)
                    known = True
    # Anything that LOOKS like the Companion Stick is protected even when it is not what we booted from.
    for n in nodes:
        labels = {str(n.get("label") or ""), str(n.get("partlabel") or "")}
        if labels & set(STICK_LABELS):
            d = disk_of(n.get("path"), nodes)
            if d:
                prot.add(d)
    # Any disk with something mounted where this session keeps its medium is in use by this session.
    for n in nodes:
        if any(m == p or m.startswith(p + "/") for m in mountpoints(n) for p in MEDIUM_MOUNTS):
            d = disk_of(n.get("path"), nodes)
            if d:
                prot.add(d)
    return prot, known


def external_bus(name):
    """True when sysfs says the disk hangs off USB or Thunderbolt (lsblk's TRAN/RM/HOTPLUG miss some bridges)."""
    try:
        real = os.path.realpath(f"/sys/block/{name}")
    except OSError:
        return False
    return "/usb" in real or "/thunderbolt" in real


def classify(nodes, source, backing=None):
    """Every whole disk -> {'path','model','size','serial','status','reason',...}. status: candidate|excluded."""
    prot, known = protected_disks(nodes, source, backing)
    disks = []
    for n in nodes:
        if n.get("type") != "disk":
            continue
        kids = flatten(n.get("children") or [], n["path"])
        d = {
            "path": n["path"], "name": n.get("name") or os.path.basename(n["path"]), "model": (n.get("model") or "").strip(),
            "size": int(n.get("size") or 0), "serial": (n.get("serial") or "").strip(),
            "tran": (n.get("tran") or "").strip(), "rotational": boolish(n.get("rota")),
            "fstype": n.get("fstype") or "", "label": n.get("label") or "",
            "partitions": [c for c in kids if c.get("type") == "part"],
            "other_children": [c for c in kids if c.get("type") != "part"],
        }
        reason = None
        if n["path"] in prot:
            reason = "the disk this session started from"
        elif boolish(n.get("rm")) or boolish(n.get("hotplug")) or d["tran"] == "usb":
            reason = "removable or USB"
        elif re.match(r"/dev/mmcblk", n["path"]):
            reason = "SD or eMMC card"
        elif external_bus(d["name"]):
            reason = "attached over USB or Thunderbolt"
        elif boolish(n.get("ro")):
            reason = "read-only"
        elif d["size"] < MIN_DISK_BYTES:
            reason = "smaller than 25 GB"
        elif re.match(r"/dev/(loop|zram|ram|sr|fd|nbd|md|dm-)", n["path"]):
            reason = "not a physical disk"
        d["status"] = "excluded" if reason else "candidate"
        d["reason"] = reason
        disks.append(d)
    return disks, known


def choose_default(candidates):
    """The disk preselected in the chooser: solid-state first (NVMe, then others), then the largest."""
    def key(d):
        return (d["tran"] != "nvme", d["rotational"], -d["size"], d["path"])
    return sorted(candidates, key=key)[0] if candidates else None


def human(n):
    for unit, div in (("TB", 1000 ** 4), ("GB", 1000 ** 3), ("MB", 1000 ** 2)):
        if n >= div:
            return f"{n / div:.0f} {unit}" if n >= 10 * div else f"{n / div:.1f} {unit}"
    return f"{n} B"


FS_NAMES = {"ntfs": "Windows (NTFS)", "vfat": "FAT/EFI", "ext4": "Linux (ext4)", "ext3": "Linux (ext3)", "btrfs": "Linux (btrfs)",
            "xfs": "Linux (xfs)", "crypto_LUKS": "encrypted (LUKS)", "swap": "swap", "exfat": "exFAT",
            "apfs": "Apple (APFS)", "hfsplus": "Apple (HFS+)", "zfs_member": "ZFS", "LVM2_member": "LVM",
            "linux_raid_member": "RAID member", "isw_raid_member": "Intel RST RAID member", "BitLocker": "BitLocker"}


def describe_disk(d):
    """('one-line header', [lines: everything found on the disk], has_data). Plain text: escape before markup."""
    head = f"{d['model'] or 'Disk'}  {human(d['size'])}  ({d['path']})"
    lines = []
    if d.get("fstype"):
        lines.append(f"  the whole disk: {FS_NAMES.get(d['fstype'], d['fstype'])}" + (f' "{d["label"]}"' if d.get("label") else ""))
    for p in d["partitions"]:
        fs = p.get("fstype") or ""
        what = FS_NAMES.get(fs, fs) if fs else "contents not recognised"
        label = f' "{p["label"]}"' if p.get("label") else ""
        lines.append(f"  {p.get('name', '?')}: {human(int(p.get('size') or 0))}, {what}{label}")
    for c in d.get("other_children", []):
        lines.append(f"  {c.get('name', '?')}: {c.get('type', 'device')}")
    has_data = bool(d["partitions"] or d.get("fstype") or d.get("other_children"))
    return head, lines, has_data


def summary(d):
    kinds = []
    for p in d["partitions"]:
        k = FS_NAMES.get(p.get("fstype") or "", p.get("fstype") or "")
        if k and k not in kinds and k != "swap":
            kinds.append(k)
    if d.get("fstype") and FS_NAMES.get(d["fstype"], d["fstype"]) not in kinds:
        kinds.insert(0, FS_NAMES.get(d["fstype"], d["fstype"]))
    return ", ".join(kinds[:3]) or ("partitions, contents not recognised" if d["partitions"] else "nothing found")


def esc(text):
    """Plain text -> zenity markup text. zenity (4.x) runs g_strcompress on it, so a backslash must be doubled too."""
    return html.escape(str(text).replace("\\", "\\\\"), quote=False)


def generate_password():
    groups = ["".join(secrets.choice(PW_ALPHABET) for _ in range(4)) for _ in range(4)]
    return "-".join(groups)


def hash_password(pw):
    r = subprocess.run(["openssl", "passwd", "-6", "-stdin"], input=pw, capture_output=True, text=True, check=True)
    return r.stdout.strip()


def target_check_command(d):
    """Shell run by the installer itself (autoinstall early-commands) before it touches any disk."""
    dev = d["path"]
    return (
        f"set -e; "
        f"[ \"$(blockdev --getsize64 {dev})\" = \"{d['size']}\" ] || {{ echo 'ci-os: {dev} is not the disk that was confirmed' >&2; exit 1; }}; "
        f"if findmnt -rn -o SOURCE /cdrom | grep -q '^{dev}'; then echo 'ci-os: {dev} carries the install medium' >&2; exit 1; fi"
    )


def available_extra_groups():
    """Groups the first user is added to on top of the installer's defaults: docker, when this image has the group.

    The installer's own list (adm cdrom dip lpadmin plugdev sambashare debian-tor libvirtd users lxd, plus sudo) has no
    docker, and the Docker engine is part of every Companion OS image. The autoinstall schema of the 26.04.1 installer
    takes `identity.groups: {append: [...]}` (autoinstall-schema.json). useradd is given the names as they are and fails
    on a group that does not exist in the new system, and the new system is a copy of this one: so the group is asked for
    only when it exists here. Without it the oneshot ci-os-docker-group.service still adds the administrators to docker
    at the first boot."""
    groups = []
    try:
        grp.getgrnam("docker")
        groups.append("docker")
    except KeyError:
        pass
    return groups


def build_autoinstall(d, password_hash, *, username="companion", realname="Companion", hostname="companion-os",
                      extra_groups=None):
    identity = {"realname": realname, "hostname": hostname, "username": username, "password": password_hash}
    if extra_groups is None:
        extra_groups = available_extra_groups()
    if extra_groups:
        identity["groups"] = {"append": list(extra_groups)}
    cfg = {
        "autoinstall": {
            "version": 1,
            "locale": "en_US.UTF-8",
            "keyboard": {"layout": "us"},
            "timezone": "geoip",
            "identity": identity,
            "storage": {"layout": {"name": "direct", "match": {"path": d["path"]}}},
            "refresh-installer": {"update": False},
            "drivers": {"install": False},
            "codecs": {"install": False},
            "updates": "security",
            # poweroff, not reboot: a stick left in the machine would boot the live session again, and the user
            # is told to remove it when the screen goes dark.
            "shutdown": "poweroff",
            "early-commands": [target_check_command(d)],
            # The first sign-in must set a real password. A stray autoinstall.yaml must not survive into the target.
            "late-commands": [
                f"curtin in-target --target=/target -- chage -d 0 {username}",
                "rm -f /target/autoinstall.yaml /target/var/log/installer/autoinstall-user-data",
            ],
        }
    }
    return cfg


def dump_yaml(cfg, mask_hash=False):
    import yaml
    c = json.loads(json.dumps(cfg))
    if mask_hash:
        c["autoinstall"]["identity"]["password"] = "<sha512-crypt hash, not shown>"
    return yaml.safe_dump(c, sort_keys=False, default_flow_style=False)


# ───────────────────────── system interaction ─────────────────────────

def is_live():
    return os.path.exists("/cdrom/casper/vmlinuz") or "boot=casper" in read_cmdline()


def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def take_lock():
    """One instance at a time. Returns True when this process holds the lock."""
    global _lock_fd
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "ci-os-auto-install.lock")
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return False
    _lock_fd = fd
    return True


def api(method, path, data=None, timeout=20):
    """(http_status, body) from the installer's API; (0, '') when it cannot be reached."""
    cmd = ["sudo", "-n", "curl", "-sS", "--max-time", str(timeout), "--unix-socket", SOCKET, "-X", method,
           "-w", "\n%{http_code}", f"http://a{path}"]
    if data is not None:
        cmd += ["-H", "Content-Type: application/json", "-d", json.dumps(data)]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except OSError:
        return 0, ""
    body, _, code = r.stdout.rpartition("\n")
    try:
        return int(code), body
    except ValueError:
        return 0, ""


def status():
    code, body = api("GET", "/meta/status")
    if code != 200:
        return {}
    try:
        return json.loads(body or "{}")
    except ValueError:
        return {}


def wait_for(states, timeout, poll=3):
    """Poll the installer until its state is in `states`. Returns (state, status) or (last state seen, {})."""
    end = time.time() + timeout
    last = None
    while time.time() < end:
        st = status()
        last = st.get("state", last)
        if st.get("state") in states:
            return st["state"], st
        time.sleep(poll)
    return last, {}


def wait_ready(timeout=180):
    """The installer's server answers and has finished starting. Returns its state, or None."""
    end = time.time() + timeout
    while time.time() < end:
        state = status().get("state")
        if state and state not in STARTUP_STATES:
            return state
        time.sleep(3)
    return None


def target_in_use():
    """True when the new system is mounted at /target (or something is mounted below it).

    curtin mounts the system it installs there and unmounts it at the very end, so a mounted /target means an install
    has written, or is writing, to a disk. When the mount table cannot be read the answer is True (fail closed)."""
    try:
        with open(MOUNTINFO, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return True
    for line in lines:
        fields = line.split()
        if len(fields) < 5:
            continue
        mountpoint = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), fields[4])   # \040 is a space in mountinfo
        if mountpoint == TARGET or mountpoint.startswith(TARGET + "/"):
            return True
    return False


def curtin_running():
    """True when a curtin process exists: the installer's disk work. pgrep that cannot run counts as running."""
    try:
        return sh(["pgrep", "-f", CURTIN_PATTERN]).returncode == 0
    except OSError:
        return True


def is_busy(state):
    """True when the installer must not be touched (no new autoinstall file, no restart of its server).

    BUSY_STATES are busy. WAITING is busy when an install has written to a disk (/target is mounted) or curtin is running,
    and idle otherwise (the installer just started, nothing answered). NEEDS_CONFIRMATION, ERROR and EXITED write nothing.
    Anything else, including a state this tool has never heard of, counts as busy: a wrong "busy" costs one more click,
    a wrong "idle" restarts the server in the middle of writing a disk."""
    if state in BUSY_STATES:
        return True
    if state == AMBIGUOUS_STATE:
        return target_in_use() or curtin_running()
    if state in IDLE_STATES:
        return False
    return True


def zenity_env():
    # ZENITY_OK / ZENITY_CANCEL / DIALOG_* can remap zenity's exit codes; the answer must mean what it says.
    return {k: v for k, v in os.environ.items() if not k.startswith(("ZENITY_", "DIALOG_"))}


def zenity(args, **kw):
    return subprocess.run(["zenity"] + args, capture_output=True, text=True, env=zenity_env(), **kw)


def choose_disk(candidates, default):
    """The one disk to offer. With several candidates the user picks; nothing is guessed. None = cancelled."""
    if len(candidates) == 1:
        return candidates[0]
    args = ["--list", "--radiolist", "--width=720", "--height=420", "--title=Install Companion OS",
            "--text=More than one internal disk was found. Which one should Companion OS be installed on?\n"
            "(You are asked to confirm before anything is erased.)",
            "--column=Pick", "--column=Device", "--column=Disk", "--column=Size", "--column=Found on it",
            "--print-column=2", "--ok-label=Continue", "--cancel-label=Cancel"]
    for d in sorted(candidates, key=lambda x: x["path"]):
        args += ["TRUE" if d is default else "FALSE", d["path"], d["model"] or "Disk", human(d["size"]), summary(d)]
    r = zenity(args)
    if r.returncode != 0:
        return None
    picked = (r.stdout or "").strip().splitlines()
    picked = picked[0].strip() if picked else ""
    return next((d for d in candidates if d["path"] == picked), None)


def confirm_dialog(d, password, other_disks):
    head, lines, _ = describe_disk(d)
    erase = "\n".join(esc(line) for line in lines) if lines else "  (nothing was found on this disk)"
    extra = ""
    if other_disks:
        extra = "\n\nOther disks (left alone): " + esc(", ".join(f"{o['model'] or o['path']} {human(o['size'])}" for o in other_disks))
    text = (
        "<big><b>Install Companion OS automatically?</b></big>\n\n"
        f"This will <b>ERASE EVERYTHING</b> on:\n<b>{esc(head)}</b>\n{erase}{extra}\n\n"
        "Nothing else is asked. Companion OS will be installed in English with a US keyboard.\n\n"
        f"Sign in afterwards as  <b>companion</b>  with this one-time password:\n<tt><big><b>{esc(password)}</b></big></tt>\n"
        "(you will be asked to choose your own at first sign-in; write it down now)\n\n"
        "When the installation is finished the computer turns off: remove the USB stick, then turn it on."
    )
    # --default-cancel: Enter, or a stray key at the login screen, never confirms an erase.
    args = ["--question", "--width=620", "--title=Install Companion OS", "--text=" + text, "--default-cancel",
            "--ok-label=Erase the disk and install", "--cancel-label=Cancel", "--extra-button=Use the normal installer"]
    r = zenity(args)
    if r.returncode == 0:
        return "install"
    if "Use the normal installer" in (r.stdout or ""):
        return "normal"
    return "cancel"


def error_dialog(text):
    zenity(["--error", "--width=520", "--title=Companion OS", "--text=" + esc(text)])


def normal_installer():
    for cand in ("ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap", "ubuntu-desktop-bootstrap"):
        if sh(["gtk-launch", cand]).returncode == 0:
            return 0
    subprocess.Popen(["/snap/bin/ubuntu-desktop-bootstrap"], start_new_session=True)
    return 0


def autoinstall_in_the_way():
    """A /autoinstall.yaml that is not ours (somebody's own unattended-install file): never overwrite or remove it."""
    if not os.path.lexists(AUTOINSTALL_LINK):
        return False
    return not (os.path.islink(AUTOINSTALL_LINK) and os.readlink(AUTOINSTALL_LINK) == AUTOINSTALL_PATH)


def remove_autoinstall():
    """Remove only our own file and our own symlink."""
    if os.path.islink(AUTOINSTALL_LINK) and os.readlink(AUTOINSTALL_LINK) == AUTOINSTALL_PATH:
        sh(["sudo", "-n", "rm", "-f", AUTOINSTALL_LINK])
    sh(["sudo", "-n", "rm", "-f", AUTOINSTALL_PATH])


def restart_server():
    sh(["sudo", "-n", "systemctl", "restart", SERVER_UNIT])


def restart_if_idle():
    """After a failure: restart the server so that it drops the autoinstall settings it loaded, unless it is installing.

    A restart kills curtin. When the failure is only that the tool gave up waiting (the install is still going), the
    install is left alone. A server whose state cannot be read is restarted: it is not answering."""
    state = status().get("state")
    if state and is_busy(state):
        return False
    restart_server()
    return True


def run_install(d, cfg_yaml, password):
    """Everything after the consent. Returns an exit code; always leaves no autoinstall file behind."""
    if sh(["sudo", "-n", "true"]).returncode != 0:
        error_dialog("The automatic install needs administrator rights, which this session does not have.")
        return 5
    if autoinstall_in_the_way():
        error_dialog("A /autoinstall.yaml that is not Companion OS's own is already present. Nothing was changed.")
        return 5
    state = wait_ready()
    if state is None:
        error_dialog("The installer is not ready. Wait a minute and try again, or use the normal installer.")
        return 5
    if is_busy(state):
        error_dialog("An installation is already running, or an earlier one left the new system mounted at /target. "
                     "Nothing was changed. If nothing is installing, restart the computer from the USB stick to try again.")
        return 5

    confirmed = False
    prog = None
    try:
        subprocess.run(["sudo", "-n", "install", "-d", "-m", "0700", RUN_DIR], check=True)
        subprocess.run(["sudo", "-n", "tee", AUTOINSTALL_PATH], input=cfg_yaml, text=True, capture_output=True, check=True)
        subprocess.run(["sudo", "-n", "chmod", "0600", AUTOINSTALL_PATH], check=True)
        # /autoinstall.yaml is where the server looks. A symlink into tmpfs means a crash cannot leave a live
        # autoinstall file behind (persistent Sticks keep the live overlay across boots): it would dangle.
        subprocess.run(["sudo", "-n", "ln", "-sfn", AUTOINSTALL_PATH, AUTOINSTALL_LINK], check=True)
        # One line each time: a "# text" line replaces the whole label, so the sign-in details ride along with every status.
        footer = (f"Sign in afterwards as companion with the one-time password {password}. When the installation is "
                  "finished the computer turns off: remove the USB stick, then turn it on.")
        prog = subprocess.Popen(
            ["zenity", "--progress", "--pulsate", "--no-cancel", "--auto-close", "--width=560",
             "--title=Installing Companion OS", "--text=" + esc(f"Starting the installer…  {footer}")],
            stdin=subprocess.PIPE, text=True, env=zenity_env())

        def say(msg):
            try:
                prog.stdin.write(f"# {esc(msg)}  {esc(footer)}\n")
                prog.stdin.flush()
            except (BrokenPipeError, ValueError):
                pass

        sh(["pkill", "-f", CLIENT_PATTERN])      # the stock client would react to the server restarting
        restart_server()
        time.sleep(3)
        state, _ = wait_for({"NEEDS_CONFIRMATION"} | INSTALL_STARTED | FAILED_STATES, 600)
        if state == "NEEDS_CONFIRMATION":
            # Last look at the disks, after everything the user could have changed while the dialog was open.
            disks2, known2 = classify(flatten(load_lsblk().get("blockdevices", [])), cdrom_source(), backing_for(cdrom_source()))
            same = [x for x in disks2 if x["status"] == "candidate" and x["path"] == d["path"] and x["size"] == d["size"]]
            if not known2 or not same:
                raise RuntimeError("the disks changed after you confirmed, so the install was not started")
            code, _ = api("POST", "/meta/confirm", "/dev/tty1")
            if code != 200:
                raise RuntimeError(f"the installer refused to start (HTTP {code})")
            confirmed = True
            state, _ = wait_for(INSTALL_STARTED | FAILED_STATES, 180)
            if state not in INSTALL_STARTED:
                raise RuntimeError(f"the installer did not start after it was confirmed (state: {state})")
        elif state in INSTALL_STARTED:
            confirmed = True
        else:
            raise RuntimeError(f"the installer did not accept the automatic install settings (state: {state})")
        say("Installing Companion OS… this takes a while")
        shown = None
        end = time.time() + 4 * 3600
        while time.time() < end:
            state = status().get("state")
            if state != shown and state:
                shown = state
                say({"RUNNING": "Installing Companion OS… this takes a while", "WAITING": "Finishing up…",
                     "LATE_COMMANDS": "Finishing up…", "UU_RUNNING": "Applying updates…"}.get(state, f"Installer state: {state}"))
            if state == "DONE":
                break
            if state in FAILED_STATES:
                raise RuntimeError("the install failed")
            time.sleep(5)
        else:
            raise RuntimeError("the install did not finish in 4 hours")
    except Exception as exc:  # noqa: BLE001 - one place that turns any failure into a visible dialog
        if prog is not None:
            prog.terminate()
        remove_autoinstall()
        restart_if_idle()                         # drop the loaded autoinstall settings: the next start is a clean one
        after = ("The disk may be partly or completely erased." if confirmed else "Nothing was erased.")
        error_dialog(f"The automatic install did not finish: {exc}.\n\n{after} Details: /var/log/installer/. "
                     "You can try the normal installer from the desktop icon.")
        return 7
    prog.terminate()
    remove_autoinstall()
    # With shutdown: poweroff the machine turns itself off about now; this is only seen if it has not yet.
    zenity(["--info", "--width=520", "--title=Companion OS is installed",
            "--text=" + esc("Companion OS is installed.\n\nWhen the computer turns off, remove the USB stick, then turn it on.\n\n"
                            f"Sign in as companion with the one-time password\n{password}")])
    return 0


def pin_to_dock(desktop_id=LAUNCHER_ID):
    """Put the launcher first in the dock's favourites (gsettings org.gnome.shell favorite-apps). True when it is there.

    The live session of Ubuntu 26.04 has no desktop icons to find the launcher by: livecd-rootfs ships a schema override
    in the live layer with disabled-extensions=['ding@rastersoft.com'] (read from the 26.04.1 image), so the file in
    ~/Desktop is never drawn. The dock is, and the stock installer sits in it already. Best effort: a failure is only logged."""
    try:
        got = sh(["gsettings", "get", "org.gnome.shell", "favorite-apps"])
        if got.returncode != 0:
            return False
        text = str(got.stdout).strip()
        favourites = ast.literal_eval(text[4:] if text.startswith("@as ") else text)     # "@as []" is how an empty list prints
        if not isinstance(favourites, list) or not all(isinstance(f, str) for f in favourites):
            return False
        if desktop_id in favourites:
            return True
        done = sh(["gsettings", "set", "org.gnome.shell", "favorite-apps", repr([desktop_id] + favourites)])
        return done.returncode == 0
    except (OSError, ValueError, SyntaxError) as exc:
        print(f"ci-os-auto-install: could not pin the launcher to the dock: {exc}", file=sys.stderr)
        return False


def live_setup():
    """Autostart hook. Does nothing outside a live session, so the installed system is untouched."""
    if not is_live():
        return 0
    home = os.path.expanduser("~")
    for folder in (os.path.join(home, "Desktop"), os.path.join(home, ".local", "share", "applications")):
        try:
            os.makedirs(folder, exist_ok=True)
            dst = os.path.join(folder, "ci-os-auto-install.desktop")
            shutil.copyfile(LAUNCHER_SRC, dst)
            os.chmod(dst, 0o755)
            # The desktop-icons extension only shows a launcher that is marked trusted.
            sh(["gio", "set", dst, "metadata::trusted", "true"])
        except OSError as exc:
            print(f"ci-os-auto-install: could not place the launcher in {folder}: {exc}", file=sys.stderr)
    pin_to_dock()
    if "ci.autoinstall=1" in read_cmdline().split():
        return interactive()
    return 0


