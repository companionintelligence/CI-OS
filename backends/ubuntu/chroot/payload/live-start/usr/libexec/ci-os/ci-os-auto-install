def backing_for(source):
    """loop_backing() for a loop /cdrom, None otherwise (so a normal medium never runs losetup)."""
    if source and re.match(r"/dev/loop\d+$", source):
        return loop_backing(source)
    return None


def main(argv=None):
    ap = argparse.ArgumentParser(description="One-click automatic Companion OS install")
    ap.add_argument("--plan", action="store_true", help="print the plan, change nothing")
    ap.add_argument("--disks", action="store_true", help="print the disk table")
    ap.add_argument("--live-setup", action="store_true", help="autostart hook: place the launcher in a live session")
    ap.add_argument("--locale", default=DEFAULT_LOCALE, help="starting language, e.g. de_DE.UTF-8")
    ap.add_argument("--keyboard", default=DEFAULT_LAYOUT, help="starting keyboard layout, e.g. de")
    ap.add_argument("--timezone", default=DEFAULT_ZONE, help="starting time zone, e.g. Europe/Berlin, or geoip")
    args = ap.parse_args(argv)
    try:
        region = new_region(args.locale, args.keyboard, args.timezone)
    except ValueError as exc:
        print(f"ci-os-auto-install: {exc}", file=sys.stderr)
        return 2
    try:
        if args.live_setup:
            return live_setup()
        return interactive(plan=args.plan, disks_table=args.disks, region=region)
    except Exception as exc:  # noqa: BLE001 - a desktop icon has no terminal: show the failure
        if args.plan or args.disks:
            raise
        error_dialog(f"The automatic install could not start: {exc}. Nothing was changed.")
        return 7


def interactive(plan=False, disks_table=False, region=None):
    region = region or new_region()
    source = cdrom_source()
    nodes = flatten(load_lsblk().get("blockdevices", []))
    disks, medium_known = classify(nodes, source, backing_for(source))

    if disks_table:
        print(f"boot medium identified: {medium_known}")
        for d in disks:
            print(f"{d['status']:9} {d['path']:14} {human(d['size']):>8}  {d['model']:24} {d['reason'] or ''}")
        return 0

    if not plan and not is_live():
        error_dialog("The automatic install only runs from the Companion OS live session.")
        return 4
    if not plan and not take_lock():
        error_dialog("The automatic installer is already open.")
        return 6
    candidates = [d for d in disks if d["status"] == "candidate"]
    target = choose_default(candidates)
    if not medium_known or target is None:
        if not medium_known:
            why = "The disk this session started from could not be identified, so no disk is offered."
        else:
            excl = "; ".join(f"{d['path']}: {d['reason']}" for d in disks if d["status"] == "excluded")
            why = "No internal disk of at least 25 GB was found." + (f" (Left out: {excl}.)" if excl else "")
        if plan:
            print("NO SAFE TARGET: " + why)
            return 3
        error_dialog(why + "\n\nUse the normal installer from the dock instead.")
        return 3

    if plan:
        others = [d for d in candidates if d is not target]
        head, lines, has_data = describe_disk(target)
        print(f"TARGET: {head}\nHAS DATA: {has_data}")
        print("\n".join(lines))
        print("OTHER DISKS: " + (", ".join(o["path"] for o in others) or "none"))
        print("EXCLUDED: " + (", ".join(f"{d['path']} ({d['reason']})" for d in disks if d["status"] == "excluded") or "none"))
        print("LANGUAGE, KEYBOARD, TIME ZONE: " + describe_region(region, load_region_data()))
        print("--- autoinstall.yaml (password hash masked) ---")
        print(dump_yaml(build_autoinstall(target, "<hash>", locale=region["locale"], layout=region["layout"],
                                          timezone=region["timezone"]), mask_hash=True))
        return 0

    if not shutil.which("zenity"):
        return 5
    target = choose_disk(candidates, target)
    if target is None:
        return 6
    others = [d for d in candidates if d is not target]
    password = generate_password()
    data = load_region_data()
    while True:
        choice = confirm_dialog(target, password, others, describe_region(region, data))
        if choice != "region":
            break
        region = choose_region(region, data)
    if choice == "normal":
        return normal_installer()
    if choice != "install":
        return 6
    # Re-check immediately before writing anything: the disk list must still say the same thing.
    src2 = cdrom_source()
    disks2, known2 = classify(flatten(load_lsblk().get("blockdevices", [])), src2, backing_for(src2))
    again = [d for d in disks2 if d["status"] == "candidate" and d["path"] == target["path"] and d["size"] == target["size"]]
    if not known2 or not again:
        error_dialog("The disks changed while you were deciding. Nothing was changed. Start the automatic install again.")
        return 3
    cfg = build_autoinstall(target, hash_password(password), locale=region["locale"], layout=region["layout"],
                            timezone=region["timezone"])
    return run_install(target, dump_yaml(cfg), password)


if __name__ == "__main__":
    sys.exit(main())
