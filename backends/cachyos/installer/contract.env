# Values the installer overlay shares with the rest of the CachyOS edition. KEY=VALUE, no quotes, sourced by nothing: read
# by iso/tests/installer-config.sh, which fails when a module config disagrees with this file. The right-hand side of each
# line is a promise made by another part of the edition; the owner is named.
#
# iso/overlay/INSTALLED.md (brand and identity overlay) defines the paths below. If it changes, change this file in the same
# commit and the test shows which module configs to update.

# Plymouth theme directory name: /usr/share/plymouth/themes/<name>/<name>.plymouth, set by modules/plymouthcfg.conf.
CI_INSTALLED_PLYMOUTH_THEME=companion-os
# GRUB theme file: modules/grubcfg.conf GRUB_THEME.
CI_INSTALLED_GRUB_THEME=/usr/share/grub/themes/companion-os/theme.txt
# Name of the UEFI boot entry and of the ESP directory: modules/bootloader.conf efiBootloaderId.
CI_EFI_BOOTLOADER_ID=companion-os
# Default hostname: modules/users.conf hostname.template.
CI_HOSTNAME=companion-os
# Product name in the installer window, the GRUB menu (bootloaderEntryName) and the cosmetic patches.
CI_PRODUCT_NAME=Companion OS
# Calamares branding component: directory name under usr/share/calamares/branding, componentName, settings.conf branding.
CI_BRANDING_COMPONENT=companion
# The one command that puts identity and brand on the target; the installer overlay calls it from the stage step.
CI_CARRY_OVER=/usr/share/ci-os/installed/carry-over
# Internet check of the welcome page: a neutral host, never a CachyOS one (decision D6).
CI_INTERNET_CHECK_URL=https://example.com
# The only bootloader on offer.
CI_BOOTLOADER=grub
