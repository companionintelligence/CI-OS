file /usr/share/calamares/settings_online.conf
file /usr/share/calamares/qml/calamares/slideshow/Presentation.qml
marker /usr/lib/calamares/modules/packages/main.py packageOperations
marker /usr/lib/calamares/modules/packages/main.py "operations"
marker /usr/lib/calamares/modules/packages/main.py needed_only
marker /usr/lib/calamares/modules/pacstrap/main.py basePackages
marker /usr/lib/calamares/modules/pacstrap/main.py postInstallFiles
marker /usr/lib/calamares/modules/pacstrap/main.py packagechooser_bootloader
marker /usr/lib/calamares/modules/bootloader/main.py efiBootLoaderVar
marker /usr/lib/calamares/modules/bootloader/main.py def install_grub
marker /usr/lib/calamares/modules/bootloader/main.py efiBootloaderId
marker /etc/calamares/modules/shellprocess.conf cp -rf /etc/skel/. /home/${USER}/.
marker /usr/lib/calamares/modules/plymouthcfg/main.py plymouth-set-default-theme
marker /usr/lib/calamares/modules/pacstrap/main.py         base_packages += ["linux-cachyos-deckify", "linux-cachyos-deckify-headers"]
marker /usr/lib/calamares/modules/pacstrap/main.py         base_packages += ["linux-cachyos", "linux-cachyos-headers",
marker /usr/lib/calamares/modules/pacstrap/main.py                          "linux-cachyos-lts", "linux-cachyos-lts-headers"]
marker /usr/lib/calamares/modules/pacstrap/main.py         base_packages += ["grub", "grub-hook", "cachyos-grub-theme", "os-prober"]
marker /usr/lib/calamares/modules/pacstrap/main.py         base_packages += ["limine", "limine-entry-tool"]
marker /usr/lib/calamares/modules/pacstrap/main.py         base_packages += ["refind"]
marker /usr/lib/calamares/modules/pacstrap/main.py         base_packages += ["systemd-boot-manager"]
marker /usr/lib/calamares/modules/pacstrap/main.py                         base_packages.append("intel-ucode")
marker /usr/lib/calamares/modules/pacstrap/main.py                         base_packages.append("amd-ucode")
marker /usr/lib/calamares/modules/pacstrap/main.py         base_packages += ["zfs-utils"]
marker /usr/lib/calamares/modules/pacstrap/main.py             base_packages += ["linux-cachyos-deckify-zfs"]
marker /usr/lib/calamares/modules/pacstrap/main.py             base_packages += ["linux-cachyos-zfs", "linux-cachyos-lts-zfs"]
marker /usr/lib/calamares/modules/pacstrap/main.py             base_packages += ["snapper", "btrfs-assistant", "limine-snapper-sync" ]
marker /usr/lib/calamares/modules/pacstrap/main.py             base_packages += ["snapper", "btrfs-assistant", "grub-btrfs-support"]
marker /usr/lib/calamares/modules/pacstrap/main.py             base_packages += ["snapper", "btrfs-assistant", "refind-btrfs" ]
marker /usr/lib/calamares/modules/pacstrap/main.py         base_packages += ["bcachefs-tools", "bcachefs-dkms"]
marker /etc/calamares/modules/shellprocess-before-online.conf CachyOS
marker /etc/calamares/scripts/bootloader-post-setup TARGET_OS_NAME="CachyOS"
marker /etc/calamares/scripts/btrfs-installation-snapshot Fresh CachyOS Installation
marker /usr/lib/calamares/modules/chwd/main.py Installing needed drivers for CachyOS
keys bootloader efiBootLoader efiBootLoaderVar efiBootMgr efiBootloaderId grubCfg grubInstall grubMkconfig grubProbe installEFIFallback installHybridGRUB kernelParams kernelPattern kernelSearchPath limineSplashLogo loaderEntries refindKernelList
keys grubcfg always_use_defaults defaults keep_distributor kernel_params overwrite prefer_grub_d
keys plymouthcfg plymouth_theme plymouth_theme_amdgpu
keys users allowActiveDirectory allowWeakPasswords allowWeakPasswordsDefault defaultGroups doAutologin doReusePassword hostname passwordRequirements platform setRootPassword sudoersGroup user
keys packages_online backend pacman skip_if_no_internet update_db update_system
keys netinstall groupsUrl label required
keys welcome_online geoip requirements showDonateUrl showKnownIssuesUrl showReleaseNotesUrl showSupportUrl
keys pacstrap basePackages postInstallFiles
keys services-systemd units
keys packagechooser_bootloader default items labels method mode
