spconf shellprocess-before-online.conf {"dontChroot": true, "i18n": "x", "script": [{"command": "cp /etc/pacman-more.conf ${ROOT}/etc/pacman.conf"}, {"command": "/etc/calamares/scripts/detect-architecture ${ROOT}/etc/pacman.conf"}], "timeout": 10}
spconf shellprocess-before.conf {"dontChroot": false, "i18n": "x", "script": [{"command": "/usr/local/bin/remove-nvidia"}, {"command": "/usr/local/bin/removeun"}, {"command": "-rm /usr/local/bin/removeun"}, {"command": "-rm /usr/local/bin/remove-nvidia"}], "timeout": 3600}
spconf shellprocess.conf {"dontChroot": false, "script": [{"command": "-rm /etc/systemd/system/etc-pacman.d-gnupg.mount"}, {"command": "-rm /etc/systemd/system/display-manager.service"}, {"command": "/etc/calamares/scripts/dmcheck"}, {"command": "-rm /etc/calamares/scripts/dmcheck"}, {"command": "-rm /usr/local/bin/dmcheck"}, {"command": "-rm -rf /home/liveuser"}, {"command": "-runuser ${USER} -c \"cp -rf /etc/skel/. /home/${USER}/.\""}, {"command": "-runuser ${USER} -c \"rm -rf /home/${USER}/{.xsession,.xprofile,.xinitrc}\""}, {"command": "/etc/calamares/scripts/shell-setup ${USER}"}, {"command": "-rm /etc/calamares/scripts/shell-setup"}, {"command": "/etc/calamares/scripts/bootloader-post-setup"}, {"command": "-rm /etc/calamares/scripts/bootloader-post-setup"}], "timeout": 3600}
spconf shellprocess_btrfs_snapshot.conf {"dontChroot": false, "i18n": "x", "script": [{"command": "/etc/calamares/scripts/btrfs-installation-snapshot"}, {"command": "-rm /etc/calamares/scripts/btrfs-installation-snapshot"}], "timeout": 300}
spconf shellprocess_cleanup_calamares.conf {"dontChroot": false, "i18n": "x", "script": [{"command": "-rmdir /etc/calamares/scripts"}, {"command": "-rmdir /etc/calamares"}], "timeout": 10}
spconf shellprocess_enable_ufw.conf {"dontChroot": false, "i18n": "x", "script": [{"command": "/etc/calamares/scripts/enable-ufw"}, {"command": "-rm /etc/calamares/scripts/enable-ufw"}], "timeout": 3600}
spconf shellprocess_greetd.conf {"dontChroot": false, "i18n": "x", "script": [{"command": "if pacman -Qs noctalia-greeter >/dev/null 2>&1; then\n  echo \"noctalia-greeter was selected. Overriding /etc/greetd/config.toml...\"\n  cp -f /usr/share/noctalia-greeter/config.toml /etc/greetd/config.toml\n  usermod -d /var/lib/noctalia-greeter -s /usr/bin/nologin greeter\n  chown -R root: /etc/greetd\n  chmod 644 /etc/greetd/config.toml\nfi"}], "timeout": 60}
spconf shellprocess_initialize_pacman.conf {"dontChroot": true, "i18n": "x", "script": [{"command": "bash /etc/calamares/scripts/update-mirrorlist", "timeout": 3600}, {"command": "bash /etc/calamares/scripts/create-pacman-keyring"}, {"command": "mkdir -p ${ROOT}/etc/pacman.d/"}, {"command": "cp /etc/pacman.d/mirrorlist ${ROOT}/etc/pacman.d/"}, {"command": "cp /etc/pacman.d/cachyos-mirrorlist ${ROOT}/etc/pacman.d/"}, {"command": "cp /etc/pacman.d/cachyos-v3-mirrorlist ${ROOT}/etc/pacman.d/"}, {"command": "cp /etc/pacman.d/cachyos-v4-mirrorlist ${ROOT}/etc/pacman.d/"}, {"command": "cp -a /etc/pacman.d/gnupg ${ROOT}/etc/pacman.d/"}, {"command": "cp /etc/resolv.conf ${ROOT}/etc/"}]}
spconf shellprocess_modify_mk_hook.conf {"dontChroot": true, "i18n": "x", "script": [{"command": "mkdir -p /etc/pacman.d/hooks/"}, {"command": "cp /etc/calamares/scripts/90-mkinitcpio-install.hook /etc/pacman.d/hooks/"}, {"command": "mkdir -p ${ROOT}/usr/share/libalpm/scripts/"}, {"command": "cp /etc/calamares/scripts/mkinitcpio-install-calamares ${ROOT}/usr/share/libalpm/scripts/"}, {"command": "chmod +x ${ROOT}/usr/share/libalpm/scripts/mkinitcpio-install-calamares"}, {"command": "mkdir -p ${ROOT}/etc/pacman.d/hooks/"}, {"command": "cp /etc/calamares/scripts/90-mkinitcpio-install.hook ${ROOT}/etc/pacman.d/hooks/"}]}
spconf shellprocess_reset_mk_hook.conf {"dontChroot": false, "i18n": "x", "script": [{"command": "rm /etc/pacman.d/hooks/90-mkinitcpio-install.hook"}, {"command": "rm /usr/share/libalpm/scripts/mkinitcpio-install-calamares"}]}
list pacstrap basePackages base base-devel btrfs-progs cachyos-hooks cachyos-keyring cachyos-mirrorlist cachyos-v4-mirrorlist cachyos-v3-mirrorlist cachyos-rate-mirrors cachyos-settings cryptsetup device-mapper diffutils dosfstools e2fsprogs efibootmgr exfatprogs f2fs-tools inetutils jfsutils less linux-firmware logrotate lsb-release lvm2 man-db man-pages mdadm chwd mkinitcpio netctl os-prober perl python s-nail sudo sysfsutils texinfo usbutils which xfsprogs plymouth cachyos-plymouth-bootanimation cachyos-plymouth-theme
