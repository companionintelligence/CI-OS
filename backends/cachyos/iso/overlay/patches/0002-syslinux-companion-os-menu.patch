# Companion OS: BIOS (syslinux) menu: titles, brand colours, and the Memtest entry path.
# upstream's archiso_tail.cfg names /%INSTALL_DIR%/boot/memtest, but mkarchiso installs the BIOS memtest at
# /boot/memtest86+/memtest (mkarchiso: install -m 0644 .../memtest.bin -> boot/memtest86+/memtest), so the entry was dead.
# That is a kernel (LINUX) line of the menu, hence the marker the overlay engine's guard (a) asks for.
# ci-os: allow-kernel-line-change
--- a/syslinux/archiso_head.cfg
+++ b/syslinux/archiso_head.cfg
@@ -1,6 +1,6 @@
 SERIAL 0 115200
 UI vesamenu.c32
-MENU TITLE CachyOS
+MENU TITLE Companion OS
 MENU BACKGROUND splash.png
 
 MENU WIDTH 78
@@ -14,15 +14,8 @@
 
 # Refer to http://syslinux.zytor.com/wiki/index.php/Doc/menu
 
-MENU COLOR border       30;44   #40ffffff #a0000000 std
-MENU COLOR title        1;36;44 #9033ccff #a0000000 std
-MENU COLOR sel          7;37;40 #e0ffffff #20ffffff all
-MENU COLOR unsel        37;44   #50ffffff #a0000000 std
-MENU COLOR help         37;40   #c0ffffff #a0000000 std
-MENU COLOR timeout_msg  37;40   #80ffffff #00000000 std
-MENU COLOR timeout      1;37;40 #c0ffffff #00000000 std
-MENU COLOR msg07        37;40   #90ffffff #a0000000 std
-MENU COLOR tabmsg       31;40   #30ffffff #00000000 std
+# The MENU COLOR lines come from the brand tokens (render-assets.sh generates companion_colors.cfg).
+INCLUDE companion_colors.cfg
 
 MENU CLEAR
 MENU IMMEDIATE
--- a/syslinux/archiso_sys.cfg
+++ b/syslinux/archiso_sys.cfg
@@ -1,6 +1,6 @@
 INCLUDE archiso_head.cfg
 
-DEFAULT arch64
+DEFAULT companion
 TIMEOUT 150
 
 INCLUDE archiso_sys-linux.cfg
--- a/syslinux/archiso_sys-linux.cfg
+++ b/syslinux/archiso_sys-linux.cfg
@@ -1,20 +1,20 @@
-LABEL cos64
+LABEL companion
 TEXT HELP
-Boot the CachyOS install medium on BIOS.
-It allows you to install CachyOS or perform system maintenance.
+Boot the Companion OS live medium on BIOS.
+It allows you to install Companion OS or perform system maintenance.
 ENDTEXT
-MENU LABEL CachyOS default (%ARCH%, BIOS)
+MENU LABEL Companion OS (Plasma, BIOS)
 LINUX /%INSTALL_DIR%/boot/%ARCH%/vmlinuz-linux-cachyos-lts
 INITRD /%INSTALL_DIR%/boot/%ARCH%/initramfs-linux-cachyos-lts.img
 APPEND archisobasedir=%INSTALL_DIR% archisosearchuuid=%ARCHISO_UUID% cow_spacesize=10G copytoram=auto module_blacklist=pcspkr i915.modeset=1 amdgpu.modeset=1 nvme_load=yes
 
 # Fallback (nomodeset)
-LABEL cos64fb
+LABEL companionfb
 TEXT HELP
-Boot the CachyOS install medium on Bios in fallback mode
-It allows you to install CachyOS or perform system maintenance.
+Boot the Companion OS live medium on BIOS with safe graphics (nomodeset).
+It allows you to install Companion OS or perform system maintenance.
 ENDTEXT
-MENU LABEL CachyOS Fallback (nomodeset, BIOS)
+MENU LABEL Companion OS (Plasma, safe graphics, BIOS)
 LINUX /%INSTALL_DIR%/boot/%ARCH%/vmlinuz-linux-cachyos-lts
 INITRD /%INSTALL_DIR%/boot/%ARCH%/initramfs-linux-cachyos-lts.img
 APPEND archisobasedir=%INSTALL_DIR% archisosearchuuid=%ARCHISO_UUID% cow_spacesize=10G copytoram=auto module_blacklist=nvidia,nvidia_modeset,nvidia_uvm,nvidia_drm,pcspkr nomodeset nvme_load=yes
--- a/syslinux/archiso_pxe-linux.cfg
+++ b/syslinux/archiso_pxe-linux.cfg
@@ -1,9 +1,9 @@
 LABEL arch64_nbd
 TEXT HELP
-Boot the CachyOS install medium using NBD.
-It allows you to install CachyOS or perform system maintenance.
+Boot the Companion OS live medium using NBD.
+It allows you to install Companion OS or perform system maintenance.
 ENDTEXT
-MENU LABEL CachyOS install medium (%ARCH%, NBD)
+MENU LABEL Companion OS live medium (%ARCH%, NBD)
 LINUX ::/%INSTALL_DIR%/boot/%ARCH%/vmlinuz-linux-cachyos-lts
 INITRD ::/%INSTALL_DIR%/boot/%ARCH%/initramfs-linux-cachyos-lts.img
 APPEND archisobasedir=%INSTALL_DIR% archisosearchuuid=%ARCHISO_UUID% archiso_nbd_srv=${pxeserver} cms_verify=y
@@ -11,10 +11,10 @@
 
 LABEL arch64_nfs
 TEXT HELP
-Boot the CachyOS live medium using NFS.
-It allows you to install CachyOS or perform system maintenance.
+Boot the Companion OS live medium using NFS.
+It allows you to install Companion OS or perform system maintenance.
 ENDTEXT
-MENU LABEL CachyOS install medium (%ARCH%, NFS)
+MENU LABEL Companion OS live medium (%ARCH%, NFS)
 LINUX ::/%INSTALL_DIR%/boot/%ARCH%/vmlinuz-linux-cachyos-lts
 INITRD ::/%INSTALL_DIR%/boot/%ARCH%/initramfs-linux-cachyos-lts.img
 APPEND archisobasedir=%INSTALL_DIR% archiso_nfs_srv=${pxeserver}:/run/archiso/bootmnt cms_verify=y
@@ -22,10 +22,10 @@
 
 LABEL arch64_http
 TEXT HELP
-Boot the CachyOS live medium using HTTP.
-It allows you to install CachyOS or perform system maintenance.
+Boot the Companion OS live medium using HTTP.
+It allows you to install Companion OS or perform system maintenance.
 ENDTEXT
-MENU LABEL CachyOS install medium (%ARCH%, HTTP)
+MENU LABEL Companion OS live medium (%ARCH%, HTTP)
 LINUX ::/%INSTALL_DIR%/boot/%ARCH%/vmlinuz-linux-cachyos-lts
 INITRD ::/%INSTALL_DIR%/boot/%ARCH%/initramfs-linux-cachyos-lts.img
 APPEND archisobasedir=%INSTALL_DIR% archiso_http_srv=http://${pxeserver}/ cms_verify=y
--- a/syslinux/archiso_tail.cfg
+++ b/syslinux/archiso_tail.cfg
@@ -10,7 +10,7 @@
 # http://www.memtest.org/
 LABEL memtest
 MENU LABEL Run Memtest86+ (RAM test)
-LINUX /%INSTALL_DIR%/boot/memtest
+LINUX /boot/memtest86+/memtest
 
 # http://hdt-project.org/
 LABEL hdt
