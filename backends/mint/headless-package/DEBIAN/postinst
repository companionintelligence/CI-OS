#!/bin/bash
set -e

# Post-installation script for setup-device package (Mint backend)

# Only manage RUNNING services when systemd is actually PID 1. In a chroot (building the ISO, debootstrap,
# pbuilder), a container or an image build there is nothing to stop or start, and the pkill calls below
# would hit unrelated processes of the BUILD HOST (libvirt and NetworkManager run dnsmasq too).
# Enabling units is a plain symlink operation and stays safe everywhere.
SYSTEMD_RUNNING=0
# ischroot (debianutils) is true inside a chroot even when the build host runs systemd and /run/systemd/system
# is visible; it is the second line of defence next to build-iso.sh giving the chroot a private /run.
if [ -d /run/systemd/system ] && ! ischroot 2>/dev/null; then SYSTEMD_RUNNING=1; fi

echo "Setting up headless device configuration..."

# Reload systemd daemon first to recognize new service definitions
if [ "$SYSTEMD_RUNNING" = 1 ]; then
    echo "Reloading systemd daemon..."
    systemctl daemon-reload
fi

# Verify systemd unit files exist and are readable
echo "Verifying systemd unit files..."
if [ ! -f /etc/systemd/system/setup-backend.service ]; then
    echo "ERROR: /etc/systemd/system/setup-backend.service not found!"
    exit 1
fi
if [ ! -f /etc/systemd/system/setup-network-monitor.service ]; then
    echo "ERROR: /etc/systemd/system/setup-network-monitor.service not found!"
    exit 1
fi
echo "✓ Unit files verified"

if [ "$SYSTEMD_RUNNING" = 1 ]; then
    # Stop any existing services from old installation (clean state)
    echo "Stopping old services from any previous installation..."
    systemctl stop setup-backend.service 2>/dev/null || true
    systemctl stop setup-network-monitor.service 2>/dev/null || true
    systemctl stop hostapd-setup.service 2>/dev/null || true
    systemctl stop dnsmasq-setup.service 2>/dev/null || true
    sleep 1

    # Kill any lingering processes
    pkill -f "setup_service.py" 2>/dev/null || true
    pkill -f "setup-network-monitor.sh" 2>/dev/null || true
    pkill -f "hostapd" 2>/dev/null || true
    pkill -f "dnsmasq" 2>/dev/null || true
    sleep 1
fi

# Remove any stale setup-complete flag to allow hotspot to start on first boot if no connectivity
echo "Resetting setup state for fresh start..."
rm -f /var/lib/setup-device/setup-complete

# Reload systemd again after stopping services (sometimes needed)
if [ "$SYSTEMD_RUNNING" = 1 ]; then
    echo "Reloading systemd daemon again..."
    systemctl daemon-reload
    sleep 1
fi

# Enable the services that run at every boot: the backend (gunicorn on 127.0.0.1:5000, idle until a request
# arrives) and the monitor that decides whether the setup hotspot is needed.
echo "Enabling services for boot-time startup..."
systemctl enable setup-backend.service 2>/dev/null || true
systemctl enable setup-network-monitor.service 2>/dev/null || true

# NOT enabled: hostapd-setup, dnsmasq-setup and nginx. setup-device-hotspot-start.sh starts all three, by name, when the
# monitor finds no connectivity, and stops them again when the hotspot episode ends. Enabled at boot they would run an
# access point on every start (the static config names one board's interface and the committed passphrase) and open
# port 80 with the setup API behind it on every network the machine joins. A package that is being UPGRADED may have
# them enabled from an older version: disable them here.
systemctl disable hostapd-setup.service 2>/dev/null || true
systemctl disable dnsmasq-setup.service 2>/dev/null || true

# Final daemon-reload before starting services
if [ "$SYSTEMD_RUNNING" = 1 ]; then
    echo "Final systemd daemon reload..."
    systemctl daemon-reload
    sleep 1
fi

# Make scripts executable
chmod 755 /usr/local/bin/setup-network-monitor.sh 2>/dev/null || true
chmod 755 /usr/local/bin/setup-device-hotspot-start.sh 2>/dev/null || true
chmod 755 /usr/local/bin/setup-device-prescan.py 2>/dev/null || true
chmod 755 /usr/local/bin/setup-wifi-recover 2>/dev/null || true
chmod 755 /usr/local/bin/ci-os-hub-start.sh 2>/dev/null || true
chmod 755 /usr/local/bin/ci-os-post-validation.sh 2>/dev/null || true

# Create required directories
mkdir -p /var/lib/setup-device
mkdir -p /var/log
mkdir -p /etc/hostapd
mkdir -p /etc/dnsmasq.d

# Restore AP config files from packaged defaults if they are missing.
if [ ! -f /etc/hostapd/hostapd-setup.conf ] && [ -f /usr/share/setup-device/defaults/hostapd-setup.conf ]; then
    cp /usr/share/setup-device/defaults/hostapd-setup.conf /etc/hostapd/hostapd-setup.conf
fi
if [ ! -f /etc/dnsmasq.d/setup-portal.conf ] && [ -f /usr/share/setup-device/defaults/setup-portal.conf ]; then
    cp /usr/share/setup-device/defaults/setup-portal.conf /etc/dnsmasq.d/setup-portal.conf
fi

chmod 600 /etc/setup-device/device.conf 2>/dev/null || true
chmod 644 /etc/hostapd/hostapd-setup.conf 2>/dev/null || true
chmod 644 /etc/dnsmasq.d/setup-portal.conf 2>/dev/null || true
chmod 644 /etc/nginx/sites-available/setup-portal 2>/dev/null || true
chmod 755 /opt/setup-backend/setup_service.py 2>/dev/null || true

# The Hub launcher entry (usr/share/applications/ci-os-hub.desktop) names the ci-os-logo icon this package ships
# in hicolor. GTK trusts icon-theme.cache over the directory, so refresh it, or the entry shows a missing icon
# until something else rebuilds the cache.
if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -d /usr/share/icons/hicolor ]; then
    gtk-update-icon-cache -q -f -t /usr/share/icons/hicolor 2>/dev/null || true
fi

# Enable nginx site
if [ -f /etc/nginx/sites-available/setup-portal ]; then
    ln -sf /etc/nginx/sites-available/setup-portal /etc/nginx/sites-enabled/setup-portal
    # Remove default site if it exists
    rm -f /etc/nginx/sites-enabled/default
fi

# NOTE: unlike backends/ubuntu/headless-package, this package ships no
# netplan config. setup_service.py's remove_setup_netplan_config() (in the
# shared, distro-portable payload) only acts on
# /etc/netplan/50-setup-mode.yaml if that file exists, and logs "already
# removed" and returns cleanly when it doesn't — so omitting it here is a
# no-op for that code path, not a missing feature. See this backend's build.sh
# header and implementation report for the fuller reasoning.

# Add setup.ci.computer to /etc/hosts
echo "Configuring hosts mapping..."
if ! grep -q "setup.ci.computer" /etc/hosts; then
    echo "192.168.99.1 setup.ci.computer" >> /etc/hosts
fi

# Setup portal uses HTTP only (no SSL) - acceptable for isolated setup network

# Remove dangling site symlinks that can break nginx -t/start
if [ -d /etc/nginx/sites-enabled ]; then
    find /etc/nginx/sites-enabled -maxdepth 1 -xtype l -delete 2>/dev/null || true
fi

# nginx on demand. The nginx package enables and starts itself when it is installed. When the portal is the ONLY site
# it would serve, that leaves the setup site on port 80 of every interface all the time; turn it off here and let the
# hotspot script start it for the length of a setup episode. If an administrator serves anything else with nginx it is
# left alone (and says so).
nginx_serves_only_the_portal() {
    for _site in /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*.conf; do
        [ -e "$_site" ] || continue
        case "$(basename "$_site")" in
            setup-portal|setup-portal.conf|default) ;;
            *) return 1 ;;
        esac
    done
    return 0
}
if nginx_serves_only_the_portal; then
    systemctl disable nginx.service 2>/dev/null || true
    if [ "$SYSTEMD_RUNNING" = 1 ]; then
        systemctl stop nginx.service 2>/dev/null || true
    fi
else
    echo "Note: nginx serves other sites on this machine; it is left enabled. The setup portal is served by it too"
    echo "while it runs - the /api/ location only answers the setup network and this machine."
fi

# Image or chroot install (no systemd running): validate the nginx config, then stop here. The enabled
# units start on the first real boot; there is nothing to start now.
if [ "$SYSTEMD_RUNNING" != 1 ]; then
    if nginx -t >/dev/null 2>&1; then
        echo "✓ Nginx configuration is valid"
    else
        echo "Warning: nginx configuration test failed"
    fi
    echo "systemd is not running (image or chroot install): the backend and the monitor are enabled and will start on first boot."
    exit 0
fi

# Validate the nginx configuration. nginx itself is NOT started here: the hotspot script starts it when the setup
# portal is needed (see above).
echo "Validating nginx configuration..."
if nginx -t; then
    echo "✓ Nginx configuration is valid"
else
    echo "Warning: nginx configuration test failed"
    echo "Portal UI may be unavailable until nginx configuration issues are fixed"
fi
sleep 1

# Start backend service
echo "Starting backend service..."
if systemctl start setup-backend.service; then
    echo "✓ Backend service started successfully"
else
    echo "WARNING: Failed to start setup-backend.service (continuing - network monitor is independent)"
    systemctl status setup-backend.service 2>&1 || true
    journalctl -u setup-backend.service -n 10 --no-pager 2>&1 || true
fi
sleep 2

# Start network monitor (critical - manages hotspot when no connectivity; independent of backend)
echo "Starting network monitor service..."
if systemctl start setup-network-monitor.service; then
    echo "✓ Network monitor service started successfully"
else
    echo "WARNING: Failed to start setup-network-monitor.service (package install will complete)"
    echo "Debug: systemctl status setup-network-monitor.service"
    systemctl status setup-network-monitor.service 2>&1 || true
fi
sleep 1

# Verify services are active and enabled
echo ""
echo "Verifying service status..."
systemctl is-active --quiet setup-backend.service && echo "✓ setup-backend.service is active" || echo "✗ setup-backend.service is not active"
systemctl is-enabled --quiet setup-backend.service && echo "✓ setup-backend.service is enabled" || echo "✗ setup-backend.service is not enabled"

systemctl is-active --quiet setup-network-monitor.service && echo "✓ setup-network-monitor.service is active" || echo "✗ setup-network-monitor.service is not active"
systemctl is-enabled --quiet setup-network-monitor.service && echo "✓ setup-network-monitor.service is enabled" || echo "✗ setup-network-monitor.service is not enabled"

systemctl is-active --quiet hostapd-setup.service && echo "✓ hostapd-setup.service is active" || echo "- hostapd-setup.service is not active (started on demand if there is no connectivity)"
systemctl is-active --quiet dnsmasq-setup.service && echo "✓ dnsmasq-setup.service is active" || echo "- dnsmasq-setup.service is not active (started on demand if there is no connectivity)"
systemctl is-active --quiet nginx.service && echo "✓ nginx.service is active" || echo "- nginx.service is not active (started on demand while the setup portal is needed)"

echo ""
echo "Setup device installation complete."
echo "Network monitor is active and will start hotspot automatically if device is disconnected."
