# Configuration files for GRUB customization

# GRUB Default Configuration for CI OS
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="CI OS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""

# CI OS Branding
GRUB_BACKGROUND="/usr/share/pixmaps/ci-os-grub-bg.png"
GRUB_COLOR_NORMAL="white/black"
GRUB_COLOR_HIGHLIGHT="black/light-gray"

# Display configuration
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep

# Disable submenu
GRUB_DISABLE_SUBMENU=y

# Recovery mode
GRUB_DISABLE_RECOVERY="false"

# Terminal settings
GRUB_TERMINAL=console
