# CI-OS v01: Bazzite NVIDIA with Wine, Proton, and WinApps Support
# NVIDIA variant based on Bazzite NVIDIA Fedora 41

ARG FEDORA_MAJOR_VERSION=41
ARG BASE_IMAGE_NAME="${BASE_IMAGE_NAME:-bazzite-nvidia}"
ARG IMAGE_FLAVOR="${IMAGE_FLAVOR:-nvidia}"

FROM ghcr.io/ublue-os/${BASE_IMAGE_NAME}:${FEDORA_MAJOR_VERSION}

ARG FEDORA_MAJOR_VERSION=41

# WinApps specific commit (pinned for stability)
ARG WINAPPS_COMMIT="0.1.0"
ARG WINE_VERSION="9.0"

# Install CI-OS branding and metadata
COPY files/system /

# Install Wine and Windows compatibility stack with NVIDIA optimizations
RUN --mount=type=cache,target=/var/cache/dnf \
    rpm-ostree install -y \
    # Wine and Windows compatibility
    wine \
    winetricks \
    # Wine 32-bit libraries and drivers
    wine.i686 \
    mesa-dri-drivers.i686 \
    mesa-vulkan-drivers.i686 \
    mesa-libGL.i686 \
    libgcc.i686 \
    glibc.i686 \
    # NVIDIA-specific Wine support
    nvidia-driver-libs.i686 \
    xorg-x11-drv-nvidia-libs.i686 \
    # Proton and gaming tools
    python3-protontricks \
    # Virtualization stack for WinApps with GPU passthrough
    qemu-kvm \
    libvirt \
    libvirt-client \
    virt-manager \
    libvirt-daemon-kvm \
    bridge-utils \
    # RDP and remote desktop
    freerdp \
    remmina \
    remmina-plugins-rdp \
    # Additional Windows app support
    cabextract \
    p7zip \
    p7zip-plugins \
    unzip \
    # Development and debugging tools
    strace \
    gdb \
    # NVIDIA development tools
    cuda-toolkit \
    nvidia-ml \
    && rpm-ostree cleanup -m \
    && ostree container commit

# Copy CI-OS specific just commands
COPY files/just /usr/share/ublue-os/justfiles/

# Copy setup scripts and configurations
COPY files/scripts /usr/share/ci-os/scripts/

# Configure Wine environment defaults with NVIDIA optimizations
RUN mkdir -p /etc/skel/.wine && \
    # Create default wine prefix structure
    mkdir -p /usr/share/ci-os/wine-configs && \
    # Set up CI-OS specific configurations
    echo 'export CI_OS_VERSION="v01"' >> /etc/environment && \
    echo 'export CI_OS_VARIANT="nvidia"' >> /etc/environment && \
    echo 'export __GL_SHADER_DISK_CACHE=1' >> /etc/environment && \
    echo 'export __GL_SHADER_DISK_CACHE_PATH=/home/$USER/.cache/nvidia' >> /etc/environment

# Install WinApps (pinned commit for stability)
RUN cd /tmp && \
    curl -L -o winapps.tar.gz "https://github.com/winapps-org/winapps/archive/refs/heads/main.tar.gz" && \
    tar xzf winapps.tar.gz && \
    mkdir -p /usr/share/ci-os/winapps && \
    cp -r winapps-main/* /usr/share/ci-os/winapps/ && \
    chmod +x /usr/share/ci-os/winapps/bin/* && \
    rm -rf /tmp/winapps* || true

# Configure systemd services
RUN systemctl enable libvirtd && \
    systemctl enable sshd && \
    systemctl enable nvidia-persistenced

# Set up Wine system configurations with NVIDIA optimizations
RUN mkdir -p /etc/wine && \
    echo 'WINEARCH=win64' > /etc/wine/wine.conf && \
    echo 'WINEPREFIX=/home/$USER/.wine' >> /etc/wine/wine.conf && \
    echo '__GL_SYNC_TO_VBLANK=1' >> /etc/wine/wine.conf

# Configure GPU passthrough for virtualization
RUN mkdir -p /etc/modprobe.d && \
    echo 'options vfio-pci ids=' > /etc/modprobe.d/vfio.conf && \
    echo 'softdep nvidia pre: vfio vfio_pci' >> /etc/modprobe.d/vfio.conf

# Final cleanup and commit
RUN rpm-ostree cleanup -m && \
    ostree container commit

# Metadata
LABEL org.opencontainers.image.title="CI-OS v01 NVIDIA"
LABEL org.opencontainers.image.description="Bazzite NVIDIA-based Linux distribution with Wine, Proton, and WinApps support"
LABEL org.opencontainers.image.version="v01"
LABEL org.opencontainers.image.vendor="Companion Intelligence"
LABEL io.artifacthub.package.readme-url="https://github.com/companionintelligence/CI-OS/blob/main/README.md"