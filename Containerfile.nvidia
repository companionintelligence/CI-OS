ARG BASE_IMAGE="ghcr.io/ublue-os/bazzite-nvidia"
ARG FEDORA_VERSION="41"

FROM ${BASE_IMAGE}:${FEDORA_VERSION}

# CI-OS version info
ARG CI_OS_VERSION="v01"
LABEL org.opencontainers.image.title="CI-OS NVIDIA"
LABEL org.opencontainers.image.description="Bazzite-based OS with NVIDIA drivers, Windows Apps Support and CI-Server"
LABEL org.opencontainers.image.version="${CI_OS_VERSION}"

# Copy customization files
COPY files/ /

# Install ujust commands
COPY files/just/ci-os.just /usr/share/ublue-os/justfiles/60-ci-os.just
COPY files/just/nvidia.just /usr/share/ublue-os/justfiles/70-nvidia.just

# Install additional packages for Windows app compatibility and NVIDIA support
RUN rpm-ostree install \
    wine \
    winetricks \
    lutris \
    protontricks \
    nvidia-container-toolkit \
    && rpm-ostree cleanup -m

# Install and configure CI-Server with NVIDIA support  
RUN /files/scripts/install-ci-server.sh

# Configure Wine with NVIDIA optimizations
RUN mkdir -p /etc/skel/.local/share/applications \
    && mkdir -p /etc/skel/.wine \
    && echo 'export __GL_SHADER_DISK_CACHE_PATH="$HOME/.cache/nvidia"' >> /etc/skel/.bashrc \
    && echo 'export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1' >> /etc/skel/.bashrc

# Configure NVIDIA-specific settings
RUN echo 'nvidia-drm.modeset=1' >> /etc/kernel/cmdline \
    && echo 'nvidia.NVreg_PreserveVideoMemoryAllocations=1' >> /etc/kernel/cmdline

# Rebuild initramfs
RUN rpm-ostree initramfs --enable

# Clean up
RUN rpm-ostree cleanup -m \
    && ostree container commit