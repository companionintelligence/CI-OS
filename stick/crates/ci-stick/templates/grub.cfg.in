# Companion Stick boot menu (@POLICY@). Generated by `ci-stick flash`; do not edit on
# the stick. Both boot chains read this same file: Canonical's signed GRUB (behind shim)
# reads EFI/BOOT/grub.cfg, else EFI/ubuntu/grub.cfg; the unsigned development GRUB reads
# ci-stick/grub.cfg. The active slot lives in ci-stick/grubenv and is changed with
# `ci-stick slot set A|B` (or by the updater), never by rewriting this file.
#
# Partitions (from the layout plan): ESP = gpt@ESP_PART@, slot A = gpt@SLOT_A_PART@, slot B = gpt@SLOT_B_PART@.

# Under Secure Boot GRUB cannot load modules from disk. Every module below is built into
# Canonical's signed grubx64.efi and into build-grub-efi.sh's image, so these lines are
# no-ops that document the dependency (a unit test keeps them in step with both images).
insmod part_gpt
insmod fat
insmod iso9660
insmod ext2
insmod regexp
insmod loadenv
insmod test
insmod echo
insmod linux

set timeout=5
set default=0

# $cmdpath is the directory GRUB was loaded from, e.g. (hd1,gpt@ESP_PART@)/EFI/BOOT. The
# stick is whichever disk that is, so never guess hd0: other disks may be attached.
set ci_disk=
regexp --set=1:ci_disk '^\(([^,)]+)' "$cmdpath"
if [ -z "$ci_disk" ]; then
  # Fallback for firmware that reports no partition in $cmdpath: find our ESP by label.
  search --no-floppy --label CI-EFI --set=ci_esp_dev
  regexp --set=1:ci_disk '^([^,]+)' "$ci_esp_dev"
fi
if [ -z "$ci_disk" ]; then
  echo "Companion Stick: cannot tell which disk this is (cmdpath=$cmdpath)."
  sleep 10
fi
set ci_esp="($ci_disk,gpt@ESP_PART@)"

set active_slot=A
set extra_cmdline=
if [ -f "$ci_esp/ci-stick/grubenv" ]; then
  load_env --file "$ci_esp/ci-stick/grubenv" active_slot extra_cmdline
fi
# Menu entries run in a fresh context that only sees exported variables.
export ci_disk
export extra_cmdline

if [ "$active_slot" = "B" ]; then
@ENTRIES_B_FIRST@
else
@ENTRIES_A_FIRST@
fi
