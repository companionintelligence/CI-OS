{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companionintelligence.com/schemas/companion-stick/bundle-1.schema.json",
  "title": "Companion Stick bundle manifest (bundle.json), schema_version 1",
  "description": "Published mirror of the Rust types in stick/crates/ci-stick/src/manifest.rs and layout.rs, which are the source of truth. The file is signed byte-for-byte by a detached ed25519 signature in bundle.json.sig. Consumers must reject unknown schema_version values and unknown fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "created_at", "artifacts", "model_packs", "layout"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "description": "Stable identifier of the bundle line.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": { "description": "Release version of this bundle.", "type": "string", "minLength": 1 },
    "created_at": {
      "description": "RFC 3339 UTC, second precision.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "artifacts": {
      "description": "Every file on the stick that the bundle vouches for, sorted by path.",
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "model_packs": { "type": "array", "items": { "$ref": "#/$defs/model_pack" } },
    "layout": { "$ref": "#/$defs/layout" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "platform": {
      "enum": ["linux-x86_64", "linux-arm64", "macos-arm64", "macos-x86_64", "windows-x86_64"]
    },
    "rel_path": {
      "description": "'/'-separated path relative to the bundle root. No empty, '.' or '..' components, no leading '/', no backslash, colon or control characters; bundle.json and bundle.json.sig are reserved.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\\\:\\u0000-\\u001f\\u007f]+$",
      "not": { "enum": ["bundle.json", "bundle.json.sig"] }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/rel_path" },
        "kind": { "enum": ["boot-image", "installer", "oci-image", "model-blob", "doc", "tool"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "platforms": {
          "description": "Host platforms this artifact is for; absent means platform-independent.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/platform" }
        }
      }
    },
    "model_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "models"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "description": { "type": "string" },
        "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/model" } }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "tag", "digest", "quantization", "license",
        "size_bytes", "min_ram_gb", "min_vram_gb", "platforms"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": {
          "description": "sha256:<hex> once resolved by `models lock`; null until then.",
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "quantization": { "type": "string" },
        "license": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "min_ram_gb": { "type": "integer", "minimum": 0 },
        "min_vram_gb": {
          "description": "null = runs acceptably on CPU / unified memory.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "platforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/platform" } }
      }
    },
    "layout": {
      "description": "The GPT partition plan the bundle was built for (policy ci-stick-layout/1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "table", "device_bytes", "usable_bytes", "partitions"],
      "properties": {
        "policy": { "type": "string" },
        "table": { "const": "gpt" },
        "device_bytes": { "type": "integer", "minimum": 0 },
        "usable_bytes": { "type": "integer", "minimum": 0 },
        "partitions": { "type": "array", "items": { "$ref": "#/$defs/partition" } }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "label", "role", "filesystem", "gpt_type", "start_bytes", "size_bytes"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" },
        "role": { "enum": ["esp", "shared", "boot-a", "boot-b", "cache", "persist"] },
        "filesystem": { "enum": ["vfat", "exfat", "raw-image", "ext4"] },
        "gpt_type": {
          "type": "string",
          "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
        },
        "start_bytes": { "type": "integer", "minimum": 0 },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
