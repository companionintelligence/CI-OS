{
  "version": "3.8",
  "services": {
    "ci-hub-db": {
      "image": "postgres:14",
      "restart": "unless-stopped",
      "stop_grace_period": 120,
      "volumes": [
        "ci_hub_pgdata:/var/lib/postgresql/data"
      ],
      "command": "-p 6543",
      "ports": [
        "6543:6543"
      ],
      "environment": {
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:-postgres}",
        "POSTGRES_USER": "${POSTGRES_USERNAME:-tipi}",
        "POSTGRES_DB": "${POSTGRES_DBNAME:-tipi}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -d tipi -U tipi -p 6543"
        ],
        "interval": "5s",
        "timeout": "20s",
        "retries": 120
      },
      "networks": [
        "ci_os_hub_network"
      ]
    },
    "ci-os-hub-queue": {
      "image": "rabbitmq:4-alpine",
      "restart": "unless-stopped",
      "ports": [
        "5001:5672"
      ],
      "environment": {
        "RABBITMQ_DEFAULT_USER": "${RABBITMQ_USERNAME:-tipi}",
        "RABBITMQ_DEFAULT_PASS": "${RABBITMQ_PASSWORD:-tipi}",
        "RABBITMQ_FEATURE_FLAGS": ""
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "rabbitmq-diagnostics -q check_running"
        ],
        "interval": "15s",
        "timeout": "30s",
        "retries": 20,
        "start_period": "180s"
      },
      "networks": [
        "ci_os_hub_network"
      ]
    },
    "ci-os-hub": {
      "image": "setup.companionintel.com/ci-os-hub:latest",
      "platform": "${DOCKER_PLATFORM:-linux/amd64}",
      "depends_on": {
        "ci-hub-db": {
          "condition": "service_healthy"
        },
        "ci-os-hub-queue": {
          "condition": "service_healthy"
        }
      },
      "restart": "unless-stopped",
      "ports": [
        "5002:5002"
      ],
      "healthcheck": {
        "start_period": "90s",
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:5002/api/health"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 15
      },
      "volumes": [
        "${RUNTIPI_MEDIA_PATH:-.internal}/media:/data/media",
        "${RUNTIPI_STATE_PATH:-.internal}/state:/data/state",
        "${RUNTIPI_REPOS_PATH:-.internal}/repos:/data/repos",
        "${RUNTIPI_APPS_PATH:-.internal}/apps:/data/apps",
        "${RUNTIPI_LOGS_PATH:-.internal}/logs:/data/logs",
        "${RUNTIPI_USER_CONFIG_PATH:-.internal}/user-config:/data/user-config",
        "${RUNTIPI_APP_DATA_PATH:-.internal}/app-data:/app-data",
        "${RUNTIPI_BACKUPS_PATH:-.internal}/backups:/data/backups",
        "${ENV_FILE:-.env}:/data/.env:ro",
        "/var/run/docker.sock:/var/run/docker.sock:ro",
        "/etc/localtime:/etc/localtime:ro",
        "/etc/timezone:/etc/timezone:ro"
      ],
      "environment": {
        "API_PORT": "5002",
        "NODE_ENV": "${NODE_ENV:-production}",
        "ROOT_FOLDER_HOST": "${ROOT_FOLDER_HOST:-.internal}",
        "POSTGRES_HOST": "ci-hub-db",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:-postgres}",
        "POSTGRES_USERNAME": "${POSTGRES_USERNAME:-tipi}",
        "POSTGRES_DBNAME": "${POSTGRES_DBNAME:-tipi}",
        "POSTGRES_PORT": "6543",
        "RABBITMQ_USERNAME": "${RABBITMQ_USERNAME:-tipi}",
        "RABBITMQ_PASSWORD": "${RABBITMQ_PASSWORD:-tipi}",
        "RABBITMQ_HOST": "ci-os-hub-queue",
        "INTERNAL_IP": "${INTERNAL_IP:-127.0.0.1}",
        "CI_CLOUD_API_URL": "${CI_CLOUD_API_URL:-https://setup.companionintel.com/api}"
      },
      "env_file": [
        "${ENV_FILE:-.env}"
      ],
      "networks": [
        "ci_os_hub_network"
      ]
    }
  },
  "networks": {
    "ci_os_hub_network": {
      "driver": "bridge"
    }
  },
  "volumes": {
    "ci_hub_pgdata": {}
  }
}
